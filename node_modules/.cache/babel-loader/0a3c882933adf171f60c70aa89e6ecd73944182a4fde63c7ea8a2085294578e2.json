{"ast":null,"code":"export default {\n  name: \"registerPage\",\n  data() {\n    return {\n      user: \"/images/user.png\",\n      email: \"/images/email.png\",\n      lock: \"/images/lock.png\",\n      key: \"/images/key.png\",\n      scream: \"/images/scream.png\",\n      backpacker: \"/images/backpacker.png\"\n    };\n  },\n  methods: {\n    goRegister() {\n      // ini nanti bisa diubah untuk POST API register\n      alert(\"Register ditekan!\");\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","email","lock","key","scream","backpacker","methods","goRegister","alert"],"sources":["C:\\xampp\\htdocs\\fahry-project\\src\\pages\\register.vue"],"sourcesContent":["<template>\r\n  <div class=\"sing-up-desktop\">\r\n    <div class=\"rectangle\"></div>\r\n\r\n    <!-- Username -->\r\n    <div class=\"form-usename\">\r\n      <div class=\"div\"></div>\r\n      <img class=\"img\" alt=\"User\" :src=\"user\" />\r\n      <div class=\"text-wrapper\">Username</div>\r\n    </div>\r\n\r\n    <!-- Email -->\r\n    <div class=\"form-email\">\r\n      <div class=\"div\"></div>\r\n      <img class=\"img\" alt=\"Email\" :src=\"email\" />\r\n      <div class=\"text-wrapper-2\">Email</div>\r\n    </div>\r\n\r\n    <!-- Password -->\r\n    <div class=\"form-pw\">\r\n      <div class=\"rectangle-2\"></div>\r\n      <img class=\"img-2\" alt=\"Lock\" :src=\"lock\" />\r\n      <div class=\"text-wrapper-3\">Password</div>\r\n    </div>\r\n\r\n    <!-- Kode OTP -->\r\n    <div class=\"form-kodeotp\">\r\n      <div class=\"rectangle-2\"></div>\r\n      <img class=\"img-2\" alt=\"Key\" :src=\"key\" />\r\n      <div class=\"text-wrapper-8\">Konfirmasi</div>\r\n    </div>\r\n\r\n    <!-- Tombol Masuk -->\r\n    <div class=\"btn-masuk\" @click=\"goRegister\">\r\n      <div class=\"rectangle-3\"></div>\r\n      <div class=\"text-wrapper-6\">Masuk</div>\r\n    </div>\r\n\r\n    <!-- Sign Title -->\r\n    <div class=\"text-wrapper-7\">Sign-in</div>\r\n\r\n    <!-- Background images -