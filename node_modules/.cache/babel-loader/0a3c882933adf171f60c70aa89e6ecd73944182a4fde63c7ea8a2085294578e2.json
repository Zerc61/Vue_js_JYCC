width: 434px;\r\n}\r\n\r\n.sing-up-desktop .img {\r\n  height: 35px;\r\n  left: 48px;\r\n  position: absolute;\r\n  top: 10px;\r\n  width: 30px;\r\n}\r\n\r\n.sing-up-desktop .text-wrapper {\r\n  color: #4d5183;\r\n  font-family: \"Inria Sans-Light\", Helvetica;\r\n  font-size: 20px;\r\n  font-weight: 300;\r\n  left: 95px;\r\n  position: absolute;\r\n  top: 14px;\r\n}\r\n\r\n.sing-up-desktop .form-email {\r\n  height: 53px;\r\n  left: 146px;\r\n  position: absolute;\r\n  top: 263px;\r\n  width: 436px;\r\n}\r\n\r\n.sing-up-desktop .text-wrapper-2 {\r\n  color: #4d5183;\r\n  font-family: \"Inria Sans-Light\", Helvetica;\r\n  font-size: 20px;\r\n  font-weight: 300;\r\n  left: 95px;\r\n  position: absolute;\r\n  top: 14px;\r\n}\r\n\r\n.sing-up-desktop .form-pw {\r\n  height: 53px;\r\n  left: 146px;\r\n  position: absolute;\r\n  top: 443px;\r\n  width: 434px;\r\n}\r\n\r\n.sing-up-desktop .rectangle-2 {\r\n  background-color: #ffffff;\r\n  border: 1px solid;\r\n  border-radius: 22px;\r\n  height: 53px;\r\n  left: 0;\r\n  position: absolute;\r\n  top: 0;\r\n  width: 432px;\r\n}\r\n\r\n.sing-up-desktop .img-2 {\r\n  height: 35px;\r\n  left: 48px;\r\n  position: absolute;\r\n  top: 8px;\r\n  width: 30px;\r\n}\r\n\r\n.sing-up-desktop .text-wrapper-3 {\r\n  color: #4d5183;\r\n  font-family: \"Inria Sans-Light\", Helvetica;\r\n  font-size: 20px;\r\n  font-weight: 300;\r\n  left: 95px;\r\n  top: 13px;\r\n  position: absolute;\r\n}\r\n\r\n.sing-up-desktop .form-kodeotp {\r\n  height: 53px;\r\n  left: 146px;\r\n  position: absolute;\r\n  top: 533px;\r\n  width: 434px;\r\n}\r\n\r\n.sing-up-desktop .text-wrapper-8 {\r\n  color: #4d5183;\r\n  font-family: \"Inria Sans-Light\", Helvetica;\r\n  font-size: 20px;\r\n  font-weight: 300;\r\n  left: 95px;\r\n  top: 13px;\r\n  position: absolute;\r\n}\r\n\r\n.sing-up-desktop .btn-login {\r\n  display: flex;\r\n  gap: 10px;\r\n  left: 251px;\r\n  position: absolute;\r\n  top: 699px;\r\n}\r\n\r\n.sing-up-desktop .text-wrapper-4 {\r\n  font-size: 20px;\r\n  font-family: \"Inria Sans-Regular\", Helvetica;\r\n}\r\n\r\n.sing-up-desktop .text-wrapper-5 {\r\n  color: #0004ff;\r\n  font-size: 20px;\r\n  cursor: pointer;\r\n  text-decoration: underline;\r\n}\r\n\r\n.sing-up-desktop .btn-masuk {\r\n  height: 53px;\r\n  left: 267px;\r\n  position: absolute;\r\n  top: 616px;\r\n  cursor: pointer;\r\n}\r\n\r\n.sing-up-desktop .rectangle-3 {\r\n  background-color: #4f5999;\r\n  border-radius: 19px;\r\n  height: 53px;\r\n  width: 176px;\r\n}\r\n\r\n.sing-up-desktop .text-wrapper-6 {\r\n  color: white;\r\n  position: absolute;\r\n  top: 15px;\r\n  left: 60px;\r\n  font-weight: bold;\r\n}\r\n\r\n.sing-up-desktop .text-wrapper-7 {\r\n  font-size: 96px;\r\n  color: #3729da;\r\n  position: absolute;\r\n  top: 92px;\r\n  left: 197px;\r\n}\r\n\r\n.sing-up-desktop .scream {\r\n  position: absolute;\r\n  left: 705px;\r\n  width: 266px;\r\n  top: 0;\r\n}\r\n\r\n.sing-up-desktop .p {\r\n  position: absolute;\r\n  top: 815px;\r\n  left: 734px;\r\n  font-size: 40px;\r\n  color: white;\r\n  text-align: center;\r\n}\r\n\r\n.sing-up-desktop .backpacker-with-open {\r\n  position: absolute;\r\n  left: 628px;\r\n  width: 812px;\r\n  top: 115px;\r\n}\r\n</style>"],"mappings":"AAuDA,eAAe;EACbA,IAAI,EAAE,cAAc;EAEpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,kBAAkB;MACxBC,KAAK,EAAE,mBAAmB;MAC1BC,IAAI,EAAE,kBAAkB;MACxBC,GAAG,EAAE,iBAAiB;MACtBC,MAAM,EAAE,oBAAoB;MAC5BC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EAEDC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX;MACAC,KAAK,CAAC,mBAAmB,CAAC;IAC5B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}