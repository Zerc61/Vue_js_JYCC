n-in-title\">Sign-in</div>\r\n\r\n      <div class=\"input-field form-email\">\r\n        <div class=\"input-box\"></div>\r\n        <i class=\"fa-solid fa-envelope icon\"></i>\r\n        <div class=\"placeholder-text\">Email</div>\r\n      </div>\r\n\r\n      <div class=\"input-field form-username\">\r\n        <div class=\"input-box\"></div>\r\n        <i class=\"fa-solid fa-user icon\"></i>\r\n        <div class=\"placeholder-text\">Username</div>\r\n      </div>\r\n\r\n      <div class=\"input-field form-password\">\r\n        <div class=\"input-box\"></div>\r\n        <i class=\"fa-solid fa-lock icon\"></i>\r\n        <div class=\"placeholder-text\">Password</div>\r\n      </div>\r\n\r\n      <div class=\"input-field form-konfirmasi\">\r\n        <div class=\"input-box\"></div>\r\n        <i class=\"fa-solid fa-key icon\"></i>\r\n        <div class=\"placeholder-text\">Konfirmasi</div>\r\n      </div>\r\n\r\n      <div class=\"btn-masuk\" @click=\"goLogin\">\r\n        <div class=\"button-box\"></div>\r\n        <div class=\"button-text\">Masuk</div>\r\n      </div>\r\n\r\n      <div class=\"signup-link-container\">\r\n        <div class=\"signup-text\">Sudah punya akun?</div>\r\n        <router-link to=\"/login\" class=\"signup-link\">Login</router-link>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"illustration-section\">\r\n      <div class=\"app-header\">\r\n        <img :src=\"require('@/assets/scream.png')\" alt=\"Logo\" class=\"app-logo\" />\r\n        <div class=\"app-name\">SCREAM DESTINATION</div>\r\n      </div>\r\n      \r\n      <img :src=\"require('@/assets/regis.png')\" alt=\"Illustrasi Traveler\" class=\"traveler-illustration\" />\r\n      \r\n      <div class=\"slogan-text\">\r\n        Start your life with a better experience\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"SignInPage\",\r\n\r\n  // Pastikan Anda telah mengimpor Font Awesome CSS di file utama HTML (index.html) atau di file global CSS Anda, \r\n  // karena link tag tidak dapat dimasukkan langsung ke dalam <template> di Vue.\r\n  // Jika Anda perlu Font Awesome, gunakan perintah:\r\n  // <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" />\r\n\r\n  methods: {\r\n    goLogin() {\r\n      alert(\"Masuk ditekan!\");\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Pastikan Anda telah mengimpor Font Awesome CSS di file utama HTML (index.html) atau di file global CSS Anda */\r\n\r\n/* Styling keseluruhan kontainer utama */\r\n.sign-in-desktop {\r\n  /* Warna latar belakang ungu gelap */\r\n  background-color: #2a1979; \r\n  min-height: 1024px;\r\n  min-width: 1440px;\r\n  position: relative;\r\n  display: flex;\r\n  justify-content: flex-start; /* Form di kiri */\r\n  align-items: center;\r\n  overflow: hidden; /* Mencegah elemen keluar */\r\n}\r\n\r\n/* Kontainer Form di sebelah kiri (Putih) */\r\n.form-container {\r\n  background-color: #ffffff;\r\n  border-radius: 62px;\r\n  /* box-shadow: inset 0px 9px 4px #00000040; */\r\n  height: 850px;\r\n  width: 646px;\r\n  position: absolute; /* Tetap di posisi kiri */\r\n  left: 30px;\r\n  top: 26px;\r\n  padding-top: 100px; /* Ruang untuk judul Sign-in */\r\n}\r\n\r\n/* Judul Sign-in */\r\n.sign-in-title {\r\n  font-size: 96px;\r\n  color: #3729da; /* Biru terang */\r\n  font-weight: bold;\r\n  position: absolute;\r\n  top: 92px;\r\n  left: 170px;\r\n}\r\n\r\n/* Penempatan Field Input */\r\n.input-field {\r\n  position: absolute;\r\n  height: 53px;\r\n  width: 436px;\r\n  left: 100px; /* Posisi horizontal relatif ke .form-container */\r\n}\r\n\r\n/* Penempatan spesifik untuk setiap field */\r\n.form-email { top: 263px; }\r\n.form-username { top: 353px; }\r\n.form-password { top: 443px; }\r\n.form-konfirmasi { top: 533px; }\r\n\r\n/* Kotak Input */\r\n.input-box {\r\n  background-color: #ffffff;\r\n  border: 1px solid #000;\r\n  border-radius: 22px;\r\n  height: 53px;\r\n  width: 434px;\r\n}\r\n\r\n/* Icon di dalam input */\r\n.icon {\r\n  font-size: 22px;\r\n  color: #4d5183; /* Abu-abu keunguan */\r\n  position: absolute;\r\n  left: 20px;\r\n  top: 15px;\r\n}\r\n\r\n/* Teks Placeholder di dalam input */\r\n.placeholder-text {\r\n  color: #4d5183;\r\n  /* Ganti 'Inria Sans-Light' dengan font yang tersedia jika tidak ada */\r\n  /* font-family: \"Inria Sans-Light\", Helvetica; */\r\n  font-size: 20px;\r\n  font-weight: 300;\r\n  position: absolute;\r\n  left: 65px;\r\n  top: 14px;\r\n}\r\n\r\n/* Tombol Masuk */\r\n.btn-masuk {\r\n  position: absolute;\r\n  left: 267px; /* Posisi horizontal relatif ke .form-container */\r\n  top: 616px;\r\n  cursor: pointer;\r\n}\r\n\r\n.button-box {\r\n  background-color: #4f5999; /* Biru keunguan */\r\n  border-radius: 19px;\r\n  height: 53px;\r\n  width: 176px;\r\n  top: 50%  ;\r\n}\r\n\r\n.button-text {\r\n  color: white;\r\n  position: absolute;\r\n  top: 15px;\r\n  left: 40px;\r\n  font-weight: bold;\r\n}\r\n\r\n/* Link Daftar/Login */\r\n.signup-link-container {\r\n  display: flex;\r\n  gap: 10px;\r\n  position: absolute;\r\n  left: 251px; /* Posisi horizontal relatif ke .form-container */\r\n  top: 699px;\r\n}\r\n\r\n.signup-text {\r\n  font-size: 20px;\r\n  color: #000; /* Hitam */\r\n}\r\n\r\n.signup-link {\r\n  color: #0004ff; /* Biru cerah */\r\n  font-size: 20px;\r\n  cursor: pointer;\r\n  text-decoration: underline; /* Sesuai gambar */\r\n  font-weight: 500;\r\n}\r\n\r\n/* --- Bagian Kanan (Ilustrasi) --- */\r\n\r\n.illustration-section {\r\n  position: absolute;\r\n  /* Kontainer kanan menutupi sisa lebar */\r\n  right: 0; \r\n  top: 0;\r\n  /* Perkiraan lebar bagian kanan */\r\n  width: 764px; \r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n/* Header Aplikasi (Logo dan Nama) */\r\n.app-header {\r\n  position: absolute;\r\n  top: 80px;\r\n  left: 100px; \r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\n.app-logo {\r\n  /* Asumsi ukuran logo di gambar */\r\n  width: 50px; \r\n  height: auto;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.app-name {\r\n  color: white;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  text-align: center;\r\n}\r\n\r\n/* Ilustrasi Orang dan Gunung */\r\n.traveler-illustration {\r\n  /* Asumsi regis.png adalah ilustrasi traveler */\r\n  width: 450px; \r\n  height: auto;\r\n  position: absolute;\r\n  top: 250px; /* Posisikan sesuai gambar */\r\n}\r\n\r\n/* Teks Slogan */\r\n.slogan-text {\r\n  position: absolute;\r\n  bottom: 120px; \r\n  color: #ffffff;\r\n  font-size: 32px;\r\n  font-weight: 600;\r\n  text-align: center;\r\n  width: 70%;\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAiB;;EACrBA,KAAK,EAAC;AAAgB;;EAgCpBA,KAAK,EAAC;AAAuB;;EAM/BA,KAAK,EAAC;AAAsB;;EAC1BA,KAAK,EAAC;AAAY;;;;;uBAxC3BC,mBAAA,CAmDM,OAnDNC,UAmDM,GAlDJC,mBAAA,CAoCM,OApCNC,UAoCM,G,6/BATJD,mBAAA,CAGM;IAHDH,KAAK,EAAC,WAAW;IAAEK,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,OAAA,IAAAD,QAAA,CAAAC,OAAA,IAAAF,IAAA,CAAO;qCACpCJ,mBAAA,CAA8B;IAAzBH,KAAK,EAAC;EAAY,2BACvBG,mBAAA,CAAoC;IAA/BH,KAAK,EAAC;EAAa,GAAC,OAAK,mB,MAGhCG,mBAAA,CAGM,OAHNO,UAGM,G,0BAFJP,mBAAA,CAAgD;IAA3CH,KAAK,EAAC;EAAa,GAAC,mBAAiB,qBAC1CW,YAAA,CAAgEC,sBAAA;IAAnDC,EAAE,EAAC,QAAQ;IAACb,KAAK,EAAC;;sBAAc,MAAK,KAAAM,MAAA,QAAAA,MAAA,O,iBAAL,OAAK,mB;;UAItDH,mBAAA,CAWM,OAXNW,UAWM,GAVJX,mBAAA,CAGM,OAHNY,UAGM,GAFJZ,mBAAA,CAAyE;IAAnEa,GAAG,EAAEC,OAAO;IAAyBC,GAAG,EAAC,MAAM;IAAClB,KAAK,EAAC;iEAC5DG,mBAAA,CAA8C;IAAzCH,KAAK,EAAC;EAAU,GAAC,oBAAkB,oB,GAG1CG,mBAAA,CAAoG;IAA9Fa,GAAG,EAAEC,OAAO;IAAwBC,GAAG,EAAC,qBAAqB;IAAClB,KAAK,EAAC;iEAE1EG,mBAAA,CAEM;IAFDH,KAAK,EAAC;EAAa,GAAC,4CAEzB,oB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}