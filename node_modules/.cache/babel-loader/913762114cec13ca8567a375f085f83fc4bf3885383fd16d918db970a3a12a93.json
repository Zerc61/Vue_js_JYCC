nk-0 w-24 text-center cursor-pointer hover:scale-105 transition\"\r\n        >\r\n          <img :src=\"u.image\" class=\"h-20 w-20 rounded-full object-cover shadow\">\r\n          <p class=\"text-xs mt-2 font-medium\">{{ u.name }}</p>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- Bottom Navigation -->\r\n    <nav class=\"fixed bottom-0 left-0 w-full bg-white shadow-lg flex justify-around py-2 text-sm border-t rounded-t-3xl\">\r\n      <div v-for=\"nav in bottomNav\" :key=\"nav.label\" class=\"flex flex-col items-center cursor-pointer hover:text-blue-600 transition\">\r\n        <span class=\"text-xl\">{{ nav.icon }}</span>\r\n        <p class=\"text-[10px]\">{{ nav.label }}</p>\r\n      </div>\r\n    </nav>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"dashboardView\",\r\n\r\n  data() {\r\n    return {\r\n      menus: [\r\n        { name: \"Halal\", icon: \"/icon1.png\" },\r\n        { name: \"UMKM\", icon: \"/icon2.png\" },\r\n        { name: \"Destinasi\", icon: \"/icon3.png\" },\r\n        { name: \"Event\", icon: \"/icon4.png\" },\r\n        { name: \"Travel\", icon: \"/icon5.png\" },\r\n        { name: \"Kuliner\", icon: \"/icon6.png\" },\r\n        { name: \"Hotel\", icon: \"/icon7.png\" },\r\n        { name: \"Tiket\", icon: \"/icon8.png\" }\r\n      ],\r\n\r\n      promos: [\r\n        { title: \"Batu Flower Garden\", image: \"/promo1.jpg\" },\r\n        { title: \"Selecta Malang\", image: \"/promo2.jpg\" }\r\n      ],\r\n\r\n      umkm: [\r\n        { name: \"Kerajinan\", image: \"/umkm1.jpg\" },\r\n        { name: \"Sambal\", image: \"/umkm2.jpg\" },\r\n        { name: \"Batik\", image: \"/umkm3.jpg\" },\r\n        { name: \"Kopi\", image: \"/umkm4.jpg\" }\r\n      ],\r\n\r\n      bottomNav: [\r\n        { label: \"Home\", icon: \"🏠\" },\r\n        { label: \"Explore\", icon: \"📍\" },\r\n        { label: \"Promo\", icon: \"⭐\" },\r\n        { label: \"Wishlist\", icon: \"❤️\" },\r\n        { label: \