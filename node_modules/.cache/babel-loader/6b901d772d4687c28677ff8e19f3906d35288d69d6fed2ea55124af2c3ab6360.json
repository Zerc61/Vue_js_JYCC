{"ast":null,"code":"export default {\n  name: \"LoginPage\",\n  data() {\n    return {\n      showLogin: false,\n      hideLogin: false,\n      showRegister: false,\n      hideRegister: false,\n      email: \"\",\n      password: \"\",\n      nama: \"\",\n      regEmail: \"\",\n      regPassword: \"\",\n      regPasswordConfirm: \"\"\n    };\n  },\n  methods: {\n    mulaiLogin() {\n      const bola = document.querySelector(\".bola\");\n      const tombol = document.querySelector(\".mulai\");\n      const foto = document.querySelector(\".foto\");\n      tombol.classList.add(\"hide-button\");\n      bola.classList.add(\"bola-hide-button\");\n      foto.classList.add(\"foto-animasi2\");\n      setTimeout(() => {\n        this.showLogin = true;\n      }, 100);\n    },\n    mulaiRegister() {\n      this.hideLogin = true;\n      setTimeout(() => {\n        this.showLogin = false;\n        this.hideRegister = false;\n        this.showRegister = true;\n      }, 400);\n    },\n    kembaliLogin() {\n      this.hideRegister = true;\n      setTimeout(() => {\n        this.showRegister = false;\n        this.hideLogin = false;\n        this.showLogin = true;\n      }, 400);\n    },\n    login() {\n      alert(`Login dengan email: ${this.email}`);\n    },\n    register() {\n      alert(`Register akun baru: ${this.nama}`);\n    }\n  }\n};","map":{"version":3,"names":["name","data","showLogin","hideLogin","showRegister","hideRegister","email","password","nama","regEmail","regPassword","regPasswordConfirm","methods","mulaiLogin","bola","document","querySelector","tombol","foto","classList","add","setTimeout","mulaiRegister","kembaliLogin","login","alert","register"],"sources":["C:\\xampp\\htdocs\\fahry-project\\src\\pages\\login.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-page\">\r\n    <div class=\"bola\"></div>\r\n\r\n    <div class=\"konten\">\r\n      <img src=\"@/assets/SCREAM_DESNITATION_4.png\" alt=\"\" class=\"foto\" />\r\n      <div class=\"button-mulai\">\r\n        <button class=\"mulai\" @click=\"mulaiLogin\">Mulai</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- LOGIN -->\r\n    <div class=\"login\" id=\"loginForm\" :class=\"{ show: showLogin, hide: hideLogin }\">\r\n      <h2>Log - in</h2>\r\n      <form @submit.prevent>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-envelope\"></i>\r\n          <input type=\"email\" placeholder=\"Email\" v-model=\"email\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-lock\"></i>\r\n          <input type=\"password\" placeholder=\"Password\" v-model=\"password\" />\r\n        </div>\r\n        <button type=\"button\" @click=\"login\">Masuk</button>\r\n        <p>Belum punya akun? <a href=\"#\" @click.prevent=\"mulaiRegister\">Register</a></p>\r\n\r\n        <div class=\"social-login\">\r\n          <div class=\"divider\">Atau</div>\r\n          <div class=\"social-icons\">\r\n            <i class=\"fa-brands fa-google\"></i>\r\n            <i class=\"fa-brands fa-twitter\"></i>\r\n            <i class=\"fa-brands fa-facebook\"></i>\r\n          </div>\r\n        </div>\r\n      </form>\r\n    </div>\r\n\r\n    <!-- REGISTER -->\r\n    <div class=\"register\" id=\"registerForm\" :class=\"{ show: showRegister, hide: hideRegister }\">\r\n      <h2>Register</h2>\r\n      <form @submit.prevent>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-user\"></i>\r\n          <input type=\"text\" placeholder=\"Nama Lengkap\" v-model=\"nama\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-envelope\"></i>\r\n          <input type=\"email\" placeholder=\"Email\" v-model=\"regEmail\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-lock\"></i>\r\n          <input type=\"password\" placeholder=\"Password\" v-model=\"regPassword\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-lock\"></i>\r\n          <input type=\"password\" placeholder=\"Konfirmasi Password\" v-model=\"regPasswordConfirm\" />\r\n        </div>\r\n        <button type=\"button\" @click=\"register\">Daftar</button>\r\n        <p>Sudah punya akun? <a href=\"#\" @click.prevent=\"kembaliLogin\">Login</a></p>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"LoginPage\",\r\n  data() {\r\n    return {\r\n      showLogin: false,\r\n      hideLogin: false,\r\n      showRegister: false,\r\n      hideRegister: false,\r\n      email: \"\",\r\n      password: \"\",\r\n      nama: \"\",\r\n      regEmail: \"\",\r\n      regPassword: \"\",\r\n      regPasswordConfirm: \"\",\r\n    };\r\n  },\r\n  methods: {\r\n    mulaiLogin() {\r\n      const bola = document.querySelector(\".bola\");\r\n      const tombol = document.querySelector(\".mulai\");\r\n      const foto = document.querySelector(\".foto\");\r\n\r\n      tombol.classList.add(\"hide-button\");\r\n      bola.classList.add(\"bola-hide-button\");\r\n      foto.classList.add(\"foto-animasi2\");\r\n\r\n      setTimeout(() => {\r\n        this.showLogin = true;\r\n      }, 100);\r\n    },\r\n    mulaiRegister() {\r\n      this.hideLogin = true;\r\n      setTimeout(() => {\r\n        this.showLogin = false;\r\n        this.hideRegister = false;\r\n        this.showRegister = true;\r\n      }, 400);\r\n    },\r\n    kembaliLogin() {\r\n      this.hideRegister = true;\r\n      setTimeout(() => {\r\n        this.showRegister = false;\r\n        this.hideLogin = false;\r\n        this.showLogin = true;\r\n      }, 400);\r\n    },\r\n    login() {\r\n      alert(`Login dengan email: ${this.email}`);\r\n    },\r\n    register() {\r\n      alert(`Register akun baru: ${this.nama}`);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* semua CSS dari file HTML kamu dimasukkan di sini */\r\n/* jika terlalu panjang, kamu bisa taruh di file CSS terpisah dan import di sini */\r\nbody, .login-page {\r\n  margin: 0;\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  background-color: #ffffff;\r\n  font-family: \"Kanit\", sans-serif;\r\n}\r\n\r\n/* semua CSS dari kode kamu di atas bisa langsung dipindahkan ke sini */\r\n\r\n.bola {\r\n  width: 30px;\r\n  height: 30px;\r\n  background-color: #083ec8;\r\n  border-radius: 50%;\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -400px) scale(1);\r\n  animation: bounce 3s ease-in-out forwards;\r\n}\r\n\r\n/* (lanjutkan semua CSS kamu seperti di HTML tadi) */\r\n</style>"],"mappings":"AAiEA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,KAAK;MAChBC,SAAS,EAAE,KAAK;MAChBC,YAAY,EAAE,KAAK;MACnBC,YAAY,EAAE,KAAK;MACnBC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,IAAI,EAAE,EAAE;MACRC,QAAQ,EAAE,EAAE;MACZC,WAAW,EAAE,EAAE;MACfC,kBAAkB,EAAE;IACtB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX,MAAMC,IAAG,GAAIC,QAAQ,CAACC,aAAa,CAAC,OAAO,CAAC;MAC5C,MAAMC,MAAK,GAAIF,QAAQ,CAACC,aAAa,CAAC,QAAQ,CAAC;MAC/C,MAAME,IAAG,GAAIH,QAAQ,CAACC,aAAa,CAAC,OAAO,CAAC;MAE5CC,MAAM,CAACE,SAAS,CAACC,GAAG,CAAC,aAAa,CAAC;MACnCN,IAAI,CAACK,SAAS,CAACC,GAAG,CAAC,kBAAkB,CAAC;MACtCF,IAAI,CAACC,SAAS,CAACC,GAAG,CAAC,eAAe,CAAC;MAEnCC,UAAU,CAAC,MAAM;QACf,IAAI,CAACnB,SAAQ,GAAI,IAAI;MACvB,CAAC,EAAE,GAAG,CAAC;IACT,CAAC;IACDoB,aAAaA,CAAA,EAAG;MACd,IAAI,CAACnB,SAAQ,GAAI,IAAI;MACrBkB,UAAU,CAAC,MAAM;QACf,IAAI,CAACnB,SAAQ,GAAI,KAAK;QACtB,IAAI,CAACG,YAAW,GAAI,KAAK;QACzB,IAAI,CAACD,YAAW,GAAI,IAAI;MAC1B,CAAC,EAAE,GAAG,CAAC;IACT,CAAC;IACDmB,YAAYA,CAAA,EAAG;MACb,IAAI,CAAClB,YAAW,GAAI,IAAI;MACxBgB,UAAU,CAAC,MAAM;QACf,IAAI,CAACjB,YAAW,GAAI,KAAK;QACzB,IAAI,CAACD,SAAQ,GAAI,KAAK;QACtB,IAAI,CAACD,SAAQ,GAAI,IAAI;MACvB,CAAC,EAAE,GAAG,CAAC;IACT,CAAC;IACDsB,KAAKA,CAAA,EAAG;MACNC,KAAK,CAAC,uBAAuB,IAAI,CAACnB,KAAK,EAAE,CAAC;IAC5C,CAAC;IACDoB,QAAQA,CAAA,EAAG;MACTD,KAAK,CAAC,uBAAuB,IAAI,CAACjB,IAAI,EAAE,CAAC;IAC3C;EACF;AACF,CAAC","ignoreList":[]},"meta