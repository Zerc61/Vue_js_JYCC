: absolute; top: 699px; } .text-wrapper-4 { font-size: 20px; } .text-wrapper-5 { color: #0004ff; font-size: 20px; cursor: pointer; text-decoration: underline; } </style>"],"mappings":"AAAC,eAAe;EAAEA,IAAI,EAAE,cAAc;EAAEC,OAAO,EAAE;IAAEC,UAAUA,CAAA,EAAG;MAAEC,KAAK,CAAC,mBAAmB,CAAC;IAAE;EAAG;AAAG,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}