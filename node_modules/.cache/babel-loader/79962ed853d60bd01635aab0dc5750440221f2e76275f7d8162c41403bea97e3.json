ateElementVNode","rel","_hoisted_1","_hoisted_2","_hoisted_3","src","require","alt","_hoisted_6","_hoisted_7","_hoisted_8","_hoisted_9","_hoisted_11","_hoisted_13"],"sources":["C:\\xampp\\htdocs\\fahry-project\\src\\pages\\login.vue"],"sourcesContent":["<template>\r\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css\"/>\r\n  <div class=\"login-web\">\r\n\r\n    <div class=\"background-section\">\r\n      \r\n      <div class=\"logo-container\">\r\n        <img :src=\"require('@/assets/scream.png')\" alt=\"SCREAM DESTINATION Logo\" class=\"app-logo\" />\r\n        <div class=\"logo-text\">SCREAM<br>DESTINATION</div>\r\n      </div>\r\n      \r\n      <img :src=\"require('@/assets/travel.png')\" alt=\"Traveler with Suitcase\" class=\"travel-illustration\" />\r\n      \r\n      <div class=\"welcome-text\">Welcome back Friend</div>\r\n\r\n    </div>\r\n\r\n    <div class=\"form-section\">\r\n      <div class=\"form-card\">\r\n\r\n        <h1 class=\"login-title\">Login</h1>\r\n\r\n        <div class=\"form-group\">\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-envelope icon\"></i>\r\n            <input type=\"email\" placeholder=\"Email\" class=\"input-field\" />\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-lock icon\"></i>\r\n            <input type=\"password\" placeholder=\"Password\" class=\"input-field\" />\r\n          </div>\r\n        </div>\r\n\r\n        <button class=\"login-btn\">Masuk</button>\r\n\r\n        <div class=\"signup-link\">\r\n          <span class=\"belum-punya-akun\">belum punya akun? </span>\r\n          <a href=\"#\" class=\"signup-text\">Sign-in</a>\r\n        </div>\r\n        \r\n        <div class=\"divider\">\r\n          <span class=\"or-text\">Atau</span>\r\n        </div>\r\n\r\n        <div class=\"social-login\">\r\n          <a href=\"#\" class=\"social-icon-link\"><img :src=\"require('@/assets/google-icon.png')\" alt=\"Google\" class=\"social-image\" /></a>\r\n          <a href=\"#\" class=\"social-icon-link\"><img :src=\"require('@/assets/twitter-icon.png')\" alt=\"Twitter\" class=\"social-image\" /></a>\r\n          <a href=\"#\" class=\"social-icon-link\"><img :src=\"require('@/assets/facebook-icon.png')\" alt=\"Facebook\" class=\"social-image\" /></a>\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n name: \"LoginPage\",\r\n};\r\n</script>\r\n\r\n\r\n<style scoped>\r\n/* Reset dasar */\r\n* {\r\n  box-sizing: border-box;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n/* Container utama */\r\n.login-web {\r\n  display: flex;\r\n  flex-direction: row;\r\n  min-height: 100vh;\r\n  /* Tambahkan font-family umum jika Anda tidak menggunakan font kustom */\r\n  font-family: Arial, sans-serif; \r\n}\r\n\r\n/* Bagian Background Kiri */\r\n.background-section {\r\n  flex: 1;\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  position: relative;\r\n  /* Warna latar belakang: Biru tua seperti di gambar */\r\n  background-color: #2A1979; \r\n  padding: 20px;\r\n}\r\n\r\n/* Penempatan Logo */\r\n.logo-container {\r\n  position: absolute;\r\n  top: 40px; /* Posisi atas */\r\n  left: 40px; /* Posisi kiri */\r\n  display: flex;\r\n  align-items: center;\r\n  color: #ffffff;\r\n  font-family: 'Inria Sans', Helvetica, sans-serif;\r\n  z-index: 10;\r\n}\r\n\r\n.app-logo {\r\n  width: 50px;\r\n  height: auto;\r\n  margin-right: 10px;\r\n}\r\n\r\n.logo-text {\r\n  font-size: 1.1rem;\r\n  font-weight: bold;\r\n  line-height: 1.1;\r\n  text-align: left;\r\n}\r\n\r\n\r\n/* Ilustrasi Traveler */\r\n.travel-illustration {\r\n  width: 100%;\r\n  max-width: 450px; /* Sesuaikan ukuran ilustrasi */\r\n  height: auto;\r\n  object-fit: contain;\r\n  margin-top: -50px; /* Tarik sedikit ke atas */\r\n}\r\n\r\n.welcome-text {\r\n  position: absolute;\r\n  bottom: 10%;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  color: #ffffff;\r\n  /* Gunakan font yang mirip jika \"Baloo Thambi-Regular\" tidak tersedia */\r\n  font-family: \"Baloo Thambi-Regular\", \"Comic Sans MS\", cursive;\r\n  font-size: 2.2rem;\r\n  font-weight: 400;\r\n  text-align: center;\r\n  white-space: nowrap;\r\n}\r\n\r\n\r\n/* Bagian Form Kanan */\r\n.form-section {\r\n  flex: 1;\r\n  min-height: 100vh;\r\n  background: #ffffff;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 0;\r\n}\r\n\r\n.form-card {\r\n  background-color: #ffffff;\r\n  /* Sudut membulat yang lebih besar di sisi kanan/bawah */\r\n  border-radius: 62px 0 0 62px; \r\n  /* Hapus box-shadow bawaan di form, ini bukan di card */\r\n  /* box-shadow: 0px 9px 4px rgba(0, 0, 0, 0.4); */\r\n  padding: 50px 70px; /* Padding lebih besar */\r\n  width: 100%;\r\n  max-width: 550px; /* Lebar maksimum untuk form */\r\n  text-align: center;\r\n  /* Terapkan bayangan di sini agar form-card terlihat seperti card yang menonjol */\r\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); \r\n  height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n}\r\n\r\n/* Untuk membuat card terlihat seperti di gambar (hanya di sisi kanan dan melayang) */\r\n.form-section {\r\n  position: relative;\r\n  background-color: #2A1979; /* Samakan warna background dengan bagian kiri untuk membuat form-card menonjol */\r\n  justify-content: flex-end; /* Dorong form-card ke sisi kanan */\r\n}\r\n\r\n.form-card {\r\n  height: 90vh; /* Tinggi card, sesuaikan */\r\n  margin: 5vh 0; /* Margin atas/bawah */\r\n  max-width: 500px;\r\n  width: 100%;\r\n  border-radius: 60px; /* Bulatkan semua sudut */\r\n  box-shadow: -10px 10px 20px rgba(0, 0, 0, 0.2); /* Bayangan untuk kesan melayang */\r\n  padding: 40px 60px;\r\n}\r\n\r\n.login-title {\r\n  color: #3729DA; /* Warna biru lebih cerah */\r\n  font-family: \"Kanit-Medium\", Helvetica;\r\n  font-size: 3.5rem; /* Ukuran lebih besar */\r\n  font-weight: 700;\r\n  margin-bottom: 40px;\r\n  text-align: left;\r\n}\r\n\r\n/* Input */\r\n.form-group {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.input-container {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  border: 1px solid #000000;\r\n  border-radius: 22px;\r\n  background-color: #ffffff;\r\n}\r\n\r\n.icon {\r\n  position: absolute;\r\n  left: 15px;\r\n  width: 20px;\r\n  height: 20px;\r\n  color: #3729DA; /* Warna ikon biru */\r\n}\r\n\r\n.input-field {\r\n  width: 100%;\r\n  padding: 15px 15px 15px 45px; /* Padding kiri disesuaikan untuk ikon */\r\n  border: none;\r\n  border-radius: 22px;\r\n  font-size: 1.1rem;\r\n  color: #4D5183;\r\n  background-color: transparent;\r\n  outline: none;\r\n}\r\n\r\n.input-field::placeholder {\r\n    color: #4D5183; /* Warna placeholder agar cocok dengan desain */\r\n    opacity: 1;\r\n}\r\n\r\n/* Tombol */\r\n.login-btn {\r\n  background-color: #4F5999;\r\n  color: #ffffff;\r\n  border: none;\r\n  border-radius: 19px;\r\n  padding: 12px 30px;\r\n  font-size: 1.2rem;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  margin: 10px 0 30px 0;\r\n  width: 100%;\r\n}\r\n\r\n.signup-link {\r\n  margin-top: 10px;\r\n  font-size: 1rem;\r\n  text-align: center;\r\n}\r\n\r\n.belum-punya-akun {\r\n  color: #000000;\r\n}\r\n\r\n.signup-text {\r\n  color: #0004FF;\r\n  text-decoration: none;\r\n  font-weight: bold;\r\n}\r\n\r\n/* Divider (Hanya menampilkan teks \"Atau\") */\r\n.divider {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin: 20px 0;\r\n}\r\n\r\n.or-text {\r\n  font-size: 1rem;\r\n  color: #000000;\r\n  padding: 0 10px;\r\n  font-weight: 500;\r\n}\r\n\r\n/* Sosial */\r\n.social-login {\r\n  display: flex;\r\n  justify-content: space-around;\r\n  align-items: center;\r\n  margin-top: 20px;\r\n  gap: 20px;\r\n}\r\n\r\n.social-icon-link {\r\n    display: inline-block;\r\n    width: 60px; /* Ukuran wadah ikon */\r\n    height: 60px;\r\n}\r\n\r\n.social-image {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n  cursor: pointer;\r\n}\r\n\r\n\r\n/* Responsif */\r\n@media (max-width: 1200px) {\r\n  .form-card {\r\n    max-width: 450px;\r\n    padding: 30px 40px;\r\n  }\r\n}\r\n\r\n\r\n@media (max-width: 992px) {\r\n  .login-web {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .background-section {\r\n    min-height: 40vh;\r\n    padding-bottom: 80px;\r\n  }\r\n\r\n  .travel-illustration {\r\n    max-width: 300px;\r\n  }\r\n\r\n  .welcome-text {\r\n    bottom: 20px;\r\n    font-size: 1.8rem;\r\n  }\r\n  \r\n  .logo-container {\r\n    top: 20px;\r\n    left: 20px;\r\n  }\r\n\r\n  .form-section {\r\n    min-height: auto;\r\n    background-color: #ffffff;\r\n  }\r\n\r\n  .form-card {\r\n    height: auto;\r\n    margin: 0;\r\n    width: 90%;\r\n    max-width: 500px;\r\n    border-radius: 30px;\r\n    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\r\n    padding: 30px;\r\n  }\r\n\r\n  .login-title {\r\n    font-size: 3rem;\r\n    text-align: center;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .welcome-text {\r\n    font-size: 1.5rem;\r\n  }\r\n\r\n  .login-title {\r\n    font-size: 2.5rem;\r\n  }\r\n\r\n  .input-field {\r\n    padding: 12px 12px 12px 40px;\r\n    font-size: 1rem;\r\n  }\r\n\r\n  .social-icon-link {\r\n    width: 50px;\r\n    height: 50px;\r\n  }\r\n}\r\n</style>"],"mappings":";;EAEOA,KAAK,EAAC;AAAW;;EAEfA,KAAK,EAAC;AAAoB;;EAExBA,KAAK,EAAC;AAAgB;;;;EAWxBA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAW;;EA6BfA,KAAK,EAAC;AAAc;;EACpBC,IAAI,EAAC,GAAG;EAACD,KAAK,EAAC;;;;EACfC,IAAI,EAAC,GAAG;EAACD,KAAK,EAAC;;;;EACfC,IAAI,EAAC,GAAG;EAACD,KAAK,EAAC;;;;uFAjD1BE,mBAAA,CAAyG;IAAnGC,GAAG,EAAC,YAAY;IAACF,IAAI,EAAC;8BAC5BC,mBAAA,CAsDM,OAtDNE,UAsDM,GApDJF,mBAAA,CAWM,OAXNG,UAWM,GATJH,mBAAA,CAGM,OAHNI,UAGM,GAFJJ,mBAAA,CAA4F;IAAtFK,GAAG,EAAEC,OAAO;IAAyBC,GAAG,EAAC,yBAAyB;IAACT,KAAK,EAAC;iEAC/