{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"topupView\",\n  methods: {\n    goBack() {\n      // contoh: router back jika pakai vue-router\n      if (this.$router) this.$router.push(\"/dashboard\");else alert(\"Back\");\n    },\n    topUp() {\n      // contoh redirect ke halaman topup\n      if (this.$router) this.$router.push(\"/isisaldo\");else alert(\"Top Up clicked\");\n    },\n    convertGold() {\n      if (this.$router) this.$router.push(\"/convert-gold\");else alert(\"Tukar Emas clicked\");\n    },\n    monthlyTrans() {\n      alert(\"Detail transaksi bulanan\");\n    },\n    coinsCashback() {\n      alert(\"Bonus cashback: 5.000 DC\");\n    },\n    sendTransfer() {\n      if (this.$router) this.$router.push(\"/transfer\");else alert(\"Transfer\");\n    },\n    showHistory() {\n      if (this.$router) this.$router.push(\"/history\");else alert(\"Riwayat\");\n    },\n    goHome() {\n      if (this.$router) this.$router.push(\"/dashboard\");\n    },\n    goExplore() {\n      if (this.$router) this.$router.push(\"/explore\");\n    },\n    goWallet() {\n      if (this.$router) this.$router.push(\"/wallet\");\n    },\n    goOrders() {\n      if (this.$router) this.$router.push(\"/orders\");\n    },\n    goProfile() {\n      if (this.$router) this.$router.push(\"/profile\");\n    }\n  }\n};","map":{"version":3,"names":["name","methods","goBack","$router","push","alert","topUp","convertGold","monthlyTrans","coinsCashback","sendTransfer","showHistory","goHome","goExplore","goWallet","goOrders","goProfile"],"sources":["C:\\laragon\\www\\FrontEndDcoin_JYCC\\src\\pages\\topup.vue"],"sourcesContent":["<template>\r\n  <div class=\"wallet-page\">\r\n    <!-- top bar -->\r\n    <header class=\"topbar\">\r\n      <button class=\"icon-btn\" @click=\"goRegister\">⟵</button>\r\n    </header>\r\n\r\n    <!-- main content container -->\r\n    <main class=\"container\">\r\n      <section class=\"wallet-card\">\r\n        <div class=\"wallet-head\">\r\n          <div class=\"wallet-title\">\r\n            <h2>Dompet Digital Kamu <span class=\"spark\">✨</span></h2>\r\n            <p class=\"subtitle\">Konversi uang kamu ke emas, dapatkan D'coin untuk transaksi halal.</p>\r\n          </div>\r\n          <div class=\"wallet-actions\">\r\n            <button class=\"btn-outline\" @click=\"showHistory\">Riwayat</button>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"balance-area\">\r\n          <div class=\"balance-left\">\r\n            <div class=\"balance-label\">Saldo D'coin</div>\r\n            <div class=\"balance-value\">100.000 <span class=\"dc\">DC</span></div>\r\n            <div class=\"balance-small\">Rp. 100.000.000 (setara 4,52 gr emas)</div>\r\n          </div>\r\n\r\n          <div class=\"balance-cta\">\r\n            <button class=\"btn-primary\" @click=\"topUp\">Isi Saldo</button>\r\n            <button class=\"btn-ghost\" @click=\"convertGold\">Tukar Emas</button>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"wallet-actions-row\">\r\n          <button class=\"small-card\" @click=\"monthlyTrans\">\r\n            <div class=\"card-title\">Transaksi Bulan Ini</div>\r\n            <div class=\"card-sub\">Rp 2.500.000</div>\r\n          </button>\r\n\r\n          <button class=\"small-card\" @click=\"coinsCashback\">\r\n            <div class=\"card-title\">Bonus Cashback</div>\r\n            <div class=\"card-sub\">+5.000 DC</div>\r\n          </button>\r\n\r\n          <button class=\"small-card\" @click=\"sendTransfer\">\r\n            <div class=\"card-title\">Kirim / Terima</div>\r\n            <div class=\"card-sub\">Transfer Instan</div>\r\n          </button>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- info / promo area -->\r\n      <section class=\"info-section\">\r\n        <h3>Penawaran & Info</h3>\r\n        <div class=\"info-grid\">\r\n          <article class=\"info-card\">\r\n            <h4>Promosi Menarik</h4>\r\n            <p>Dapatkan 10% cashback untuk top up minimal Rp50.000.</p>\r\n          </article>\r\n          <article class=\"info-card\">\r\n            <h4>Keamanan</h4>\r\n            <p>Transaksi dilindungi OTP & enkripsi end-to-end.</p>\r\n          </article>\r\n        </div>\r\n      </section>\r\n    </main>\r\n\r\n    <!-- bottom nav -->\r\n    <nav class=\"bottom-nav\">\r\n      <button class=\"nav-item\" @click=\"goHome\">🏠<span>Home</span></button>\r\n      <button class=\"nav-item\" @click=\"goExplore\">📍<span>Explore</span></button>\r\n      <button class=\"nav-item active\" @click=\"goWallet\">💰<span>Dompet</span></button>\r\n      <button class=\"nav-item\" @click=\"goOrders\">🧾<span>Pesanan</span></button>\r\n      <button class=\"nav-item\" @click=\"goProfile\">👤<span>Akun</span></button>\r\n    </nav>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"topupView\",\r\n  methods: {\r\n    goBack() {\r\n      // contoh: router back jika pakai vue-router\r\n      if (this.$router) this.$router.push(\"/dashboard\");\r\n      else alert(\"Back\");\r\n    },\r\n    topUp() {\r\n      // contoh redirect ke halaman topup\r\n      if (this.$router) this.$router.push(\"/isisaldo\");\r\n      else alert(\"Top Up clicked\");\r\n    },\r\n    convertGold() {\r\n      if (this.$router) this.$router.push(\"/convert-gold\");\r\n      else alert(\"Tukar Emas clicked\");\r\n    },\r\n    monthlyTrans() {\r\n      alert(\"Detail transaksi bulanan\");\r\n    },\r\n    coinsCashback() {\r\n      alert(\"Bonus cashback: 5.000 DC\");\r\n    },\r\n    sendTransfer() {\r\n      if (this.$router) this.$router.push(\"/transfer\");\r\n      else alert(\"Transfer\");\r\n    },\r\n    showHistory() {\r\n      if (this.$router) this.$router.push(\"/history\");\r\n      else alert(\"Riwayat\");\r\n    },\r\n    goHome(){ if(this.$router) this.$router.push(\"/dashboard\"); },\r\n    goExplore(){ if(this.$router) this.$router.push(\"/explore\"); },\r\n    goWallet(){ if(this.$router) this.$router.push(\"/wallet\"); },\r\n    goOrders(){ if(this.$router) this.$router.push(\"/orders\"); },\r\n    goProfile(){ if(this.$router) this.$router.push(\"/profile\"); }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n\r\n\r\n/* page */\r\n.wallet-page {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: linear-gradient(180deg, #f7fbff 0%, #f0f7ff 40%, #eaf6ff 100%);\r\n  color: #0f172a;\r\n  font-family: Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial;\r\n}\r\n\r\n/* topbar */\r\n.topbar {\r\n  height: 56px;\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 16px;\r\n}\r\n.icon-btn {\r\n  background: rgba(255,255,255,0.6);\r\n  border: none;\r\n  width: 36px;\r\n  height: 36px;\r\n  border-radius: 10px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  box-shadow: 0 6px 12px rgba(2,6,23,0.06);\r\n}\r\n\r\n/* container */\r\n.container {\r\n  width: 100%;\r\n  max-width: 920px;\r\n  margin: 12px auto;\r\n  padding: 0 16px 80px; /* bottom padding for nav */\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* wallet card */\r\n.wallet-card {\r\n  background: linear-gradient(180deg, #ffffff 0%, #f8fdff 100%);\r\n  border-radius: 18px;\r\n  padding: 18px;\r\n  box-shadow: 0 12px 30px rgba(2,6,23,0.08);\r\n  overflow: hidden;\r\n}\r\n\r\n/* header inside card */\r\n.wallet-head {\r\n  display:flex;\r\n  justify-content:space-between;\r\n  gap:12px;\r\n  align-items:flex-start;\r\n  margin-bottom: 8px;\r\n}\r\n.wallet-title h2 {\r\n  margin:0;\r\n  font-size:20px;\r\n}\r\n.wallet-title .subtitle {\r\n  margin-top:6px;\r\n  color:#475569;\r\n  font-size:13px;\r\n}\r\n\r\n/* balance area */\r\n.balance-area {\r\n  display:flex;\r\n  gap:16px;\r\n  align-items:center;\r\n  justify-content:space-between;\r\n  margin-top:12px;\r\n  flex-wrap:wrap;\r\n}\r\n.balance-left {\r\n  min-width: 220px;\r\n}\r\n.balance-label { color:#64748b; font-size:13px; margin-bottom:6px; }\r\n.balance-value { font-size:28px; font-weight:800; color:#0f172a; display:flex; align-items:baseline; gap:8px; }\r\n.balance-value .dc { font-size:14px; font-weight:700; color:#2563eb; }\r\n.balance-small { color:#94a3b8; font-size:12px; margin-top:6px; }\r\n\r\n/* CTA buttons */\r\n.balance-cta { display:flex; gap:10px; align-items:center; }\r\n.btn-primary {\r\n  background: linear-gradient(180deg,#1e40af,#2563eb);\r\n  color:white;\r\n  border:none;\r\n  padding:10px 14px;\r\n  border-radius:12px;\r\n  font-weight:700;\r\n  cursor:pointer;\r\n  box-shadow: 0 8px 20px rgba(37,99,235,0.18);\r\n}\r\n.btn-ghost {\r\n  background: transparent;\r\n  color:#0f172a;\r\n  border:1px solid rgba(15,23,42,0.06);\r\n  padding:10px 12px;\r\n  border-radius:12px;\r\n  cursor:pointer;\r\n}\r\n\r\n/* small cards row */\r\n.wallet-actions-row {\r\n  display:flex;\r\n  gap:10px;\r\n  margin-top:16px;\r\n  flex-wrap:wrap;\r\n}\r\n.small-card {\r\n  flex:1 1 30%;\r\n  min-width:140px;\r\n  background:#fff;\r\n  padding:12px;\r\n  border-radius:12px;\r\n  border:1px solid rgba(2,6,23,0.04);\r\n  box-shadow: 0 8px 18px rgba(2,6,23,0.04);\r\n  cursor:pointer;\r\n  text-align:left;\r\n}\r\n.small-card .card-title { font-weight:700; color:#0f172a; }\r\n.small-card .card-sub { color:#475569; margin-top:6px; font-size:13px; }\r\n\r\n/* info area */\r\n.info-section { margin-top:18px; }\r\n.info-grid { display:grid; grid-template-columns: repeat(2,1fr); gap:12px; margin-top:8px; }\r\n.info-card { background:#fff; padding:12px; border-radius:12px; box-shadow:0 8px 18px rgba(2,6,23,0.04); }\r\n\r\n/* bottom navigation */\r\n.bottom-nav {\r\n  position: fixed;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  bottom: 14px;\r\n  width: calc(100% - 40px);\r\n  max-width: 920px;\r\n  background: #ffffff;\r\n  border-radius: 18px;\r\n  padding: 8px 10px;\r\n  display:flex;\r\n  justify-content:space-around;\r\n  box-shadow: 0 12px 28px rgba(2,6,23,0.12);\r\n  z-index: 40;\r\n}\r\n.nav-item {\r\n  background: transparent;\r\n  border: none;\r\n  display:flex;\r\n  flex-direction:column;\r\n  align-items:center;\r\n  gap:4px;\r\n  font-size:13px;\r\n  cursor:pointer;\r\n}\r\n.nav-item span { font-size:18px; }\r\n.nav-item.active { color:#2563eb; font-weight:700; }\r\n\r\n/* responsive */\r\n@media (max-width: 720px) {\r\n  .info-grid { grid-template-columns: repeat(1,1fr); }\r\n  .wallet-head { flex-direction:column; align-items:flex-start; gap:8px; }\r\n  .balance-area { flex-direction:column; align-items:flex-start; gap:12px; }\r\n  .bottom-nav { width: calc(100% - 24px); left: 12px; transform:none; }\r\n}\r\n</style>\r\n"],"mappings":";AA+EA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,OAAO,EAAE;IACPC,MAAMA,CAAA,EAAG;MACP;MACA,IAAI,IAAI,CAACC,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,YAAY,CAAC,MAC5CC,KAAK,CAAC,MAAM,CAAC;IACpB,CAAC;IACDC,KAAKA,CAAA,EAAG;MACN;MACA,IAAI,IAAI,CAACH,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,WAAW,CAAC,MAC3CC,KAAK,CAAC,gBAAgB,CAAC;IAC9B,CAAC;IACDE,WAAWA,CAAA,EAAG;MACZ,IAAI,IAAI,CAACJ,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,eAAe,CAAC,MAC/CC,KAAK,CAAC,oBAAoB,CAAC;IAClC,CAAC;IACDG,YAAYA,CAAA,EAAG;MACbH,KAAK,CAAC,0BAA0B,CAAC;IACnC,CAAC;IACDI,aAAaA,CAAA,EAAG;MACdJ,KAAK,CAAC,0BAA0B,CAAC;IACnC,CAAC;IACDK,YAAYA,CAAA,EAAG;MACb,IAAI,IAAI,CAACP,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,WAAW,CAAC,MAC3CC,KAAK,CAAC,UAAU,CAAC;IACxB,CAAC;IACDM,WAAWA,CAAA,EAAG;MACZ,IAAI,IAAI,CAACR,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,UAAU,CAAC,MAC1CC,KAAK,CAAC,SAAS,CAAC;IACvB,CAAC;IACDO,MAAMA,CAAA,EAAE;MAAE,IAAG,IAAI,CAACT,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,YAAY,CAAC;IAAE,CAAC;IAC7DS,SAASA,CAAA,EAAE;MAAE,IAAG,IAAI,CAACV,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,UAAU,CAAC;IAAE,CAAC;IAC9DU,QAAQA,CAAA,EAAE;MAAE,IAAG,IAAI,CAACX,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,SAAS,CAAC;IAAE,CAAC;IAC5DW,QAAQA,CAAA,EAAE;MAAE,IAAG,IAAI,CAACZ,OAAO,EAAE,IAAI,CAACA,OAAO,CAACC,IAAI,CAAC,SAAS,CAAC;IAAE,CAAC;IAC5DY,SAASA,CAAA,EAAE;MAAE,IAAG,IAAI,CAACb,OAAO,EAAE,IAAI,CAACA