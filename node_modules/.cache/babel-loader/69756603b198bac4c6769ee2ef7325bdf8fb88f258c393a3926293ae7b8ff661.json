text-xs font-bold bg-red-100 px-2 py-1 rounded-lg\"\r\n              >20% OFF</span\r\n            >\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- UMKM Populer -->\r\n    <section class=\"p-4\">\r\n      <h2 class=\"font-semibold text-lg mb-3\">UMKM Populer</h2>\r\n\r\n      <div class=\"flex space-x-4 overflow-x-auto no-scrollbar\">\r\n        <div\r\n          v-for=\"u in umkm\"\r\n          :key=\"u.name\"\r\n          class=\"flex-shrink-0 w-24 text-center cursor-pointer hover:scale-105 transition\"\r\n        >\r\n          <img\r\n            :src=\"u.image\"\r\n            class=\"h-20 w-20 rounded-full object-cover shadow\"\r\n          />\r\n          <p class=\"text-xs mt-2 font-medium\">{{ u.name }}</p>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- Bottom Navigation -->\r\n    <nav\r\n      class=\"fixed bottom-0 left-0 w-full bg-white shadow-lg flex justify-around py-2 text-sm border-t rounded-t-3xl\"\r\n    >\r\n      <div\r\n        v-for=\"nav in bottomNav\"\r\n        :key=\"nav.label\"\r\n        class=\"flex flex-col items-center cursor-pointer hover:text-blue-600 transition\"\r\n      >\r\n        <span class=\"text-xl\">{{ nav.icon }}</span>\r\n        <p class=\"text-[10px]\">{{ nav.label }}</p>\r\n      </div>\r\n    </nav>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"DashboardView\",\r\n\r\n  data() {\r\n    return {\r\n      menus: [\r\n        { name: \"Halal\", icon: \"/icon1.png\", route: \"/halal\" },\r\n        { name: \"UMKM\", icon: \"/icon2.png\", route: \"/umkm\" },\r\n        { name: \"Destinasi\", icon: \"/icon3.png\", route: \"/destinasi\" },\r\n        { name: \"Event\", icon: \"/icon4.png\", route: \"/event\" },\r\n        { name: \"Travel\", icon: \"/icon5.png\", route: \"/travel\" },\r\n        { name: \"Kuliner\", icon: \"/icon6.png\", route: \"/kuliner\" },\r\n        { name: \"Hotel\", icon: \"/icon7.png\", route: \"/hotel\" },\r\n        { name: \"Tiket\", icon: \"/icon8.png\", route: \"/tiket\" },\r\n\r\n        // ⭐ MENU BARU: TOP UP\r\n        { name: \"Top Up\", icon: \"/icon9.png\", route: \"/topup\" },\r\n      ],\r\n\r\n      promos: [\r\n        { title: \"Batu Flower Garden\", image: \"/promo1.jpg\" },\r\n        { title: \"Selecta Malang\", image: \"/promo2.jpg\" },\r\n      ],\r\n\r\n      umkm: [\r\n        { name: \"Kerajinan\", image: \"/umkm1.jpg\" },\r\n        { name: \"Sambal\", image: \"/umkm2.jpg\" },\r\n        { name: \"Batik\", image: \"/umkm3.jpg\" },\r\n        { name: \"Kopi\", image: \"/umkm4.jpg\" },\r\n      ],\r\n\r\n      bottomNav: [\r\n        { label: \"Home\", icon: \"🏠\" },\r\n        { label: \"Explore\", icon: \"📍\" },\r\n        { label: \"Promo\", icon: \"⭐\" },\r\n        { label: \"Wishlist\", icon: \"❤️\" },\r\n        { label: \"Akun\", icon: \"👤\" },\r\n      ],\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n.no-scrollbar::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n.no-scrollbar {\r\n  -ms-overflow-style: none;\r\n  scrollbar-width: none;\r\n}\r\n</style>\r\n"],"mappings":"AA8FA,eAAe;EACbA,IAAI,EAAE,eAAe;EAErBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,CACL;QAAEF,IAAI,EAAE,OAAO;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAS,CAAC,EACtD;QAAEJ,IAAI,EAAE,MAAM;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAQ,CAAC,EACpD;QAAEJ,IAAI,EAAE,WAAW;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAa,CAAC,EAC9D;QAAEJ,IAAI,EAAE,OAAO;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAS,CAAC,EACtD;QAAEJ,IAAI,EAAE,QAAQ;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAU,CAAC,EACxD;QAAEJ,IAAI,EAAE,SAAS;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAW,CAAC,EAC1D;QAAEJ,IAAI,EAAE,OAAO;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAS,CAAC,EACtD;QAAEJ,IAAI,EAAE,OAAO;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAS,CAAC;MAEtD;MACA;QAAEJ,IAAI,EAAE,QAAQ;QAAEG,IAAI,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAS,CAAC,CACxD;MAEDC,MAAM,EAAE,CACN;QAAEC,KAAK,EAAE,oBAAoB;QAAEC,KAAK,EAAE;MAAc,CAAC,EACrD;QAAED,KAAK,EAAE,gBAAgB;QAAEC,KAAK,EAAE;MAAc