r\n            <i class=\"fa-brands fa-twitter\"></i>\r\n            <i class=\"fa-brands fa-facebook\"></i>\r\n          </div>\r\n        </div>\r\n      </form>\r\n    </div>\r\n\r\n    <!-- REGISTER -->\r\n    <div class=\"register\" :class=\"{ show: showRegister, hide: hideRegister }\">\r\n      <h2>Register</h2>\r\n      <form @submit.prevent>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-user\"></i>\r\n          <input type=\"text\" placeholder=\"Nama Lengkap\" v-model=\"nama\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-envelope\"></i>\r\n          <input type=\"email\" placeholder=\"Email\" v-model=\"regEmail\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-lock\"></i>\r\n          <input type=\"password\" placeholder=\"Password\" v-model=\"regPassword\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-lock\"></i>\r\n          <input\r\n            type=\"password\"\r\n            placeholder=\"Konfirmasi Password\"\r\n            v-model=\"regPasswordConfirm\"\r\n          />\r\n        </div>\r\n        <button type=\"button\">Daftar</button>\r\n        <p>Sudah punya akun?\r\n          <a href=\"#\" @click.prevent=\"kembaliLogin\">Login</a>\r\n        </p>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref } from \"vue\";\r\n\r\nconst showLogin = ref(false);\r\nconst hideLogin = ref(false);\r\nconst showRegister = ref(false);\r\nconst hideRegister = ref(false);\r\n\r\nconst email = ref(\"\");\r\nconst password = ref(\"\");\r\nconst nama = ref(\"\");\r\nconst regEmail = ref(\"\");\r\nconst regPassword = ref(\"\");\r\nconst regPasswordConfirm = ref(\"\");\r\n\r\nfunction mulaiLogin() {\r\n  const bola = document.querySelector(\".bola\");\r\n  const tombol = document.querySelector(\".mulai\");\r\n  const foto = document.querySelector(\".foto\");\r\n\r\n  tombol.classList.add(\"hide-button\");\r\n  bola.classList.add(\"bola-hide-button\");\r\n  foto.classList.add(\"foto-animasi2\");\r\n\r\n  setTimeout(() => {\r\n    showLogin.value = true;\r\n  }, 100);\r\n}\r\n\r\nfunction mulaiRegister() {\r\n  hideLogin.value = true;\r\n  setTimeout(() => {\r\n    showLogin.value = false;\r\n    hideRegister.value = false;\r\n    showRegister.value = true;\r\n  }, 400);\r\n}\r\n\r\nfunction kembaliLogin() {\r\n  hideRegister.value = true;\r\n  setTimeout(() => {\r\n    showRegister.value = false;\r\n    hideLogin.value = false;\r\n    showLogin.value = true;\r\n  }, 400);\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n@import url(\"https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600&display=swap\");\r\n@import url(\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css\");\r\n\r\n.login-page {\r\n  margin: 0;\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  background-color: #ffffff;\r\n  font-family: \"Kanit\", sans-serif;\r\n}\r\n\r\n/* ==== semua CSS kamu dimasukkan di bawah ini ==== */\r\n\r\n.bola {\r\n  width: 30px;\r\n  height: 30px;\r\n  background-color: #083ec8;\r\n  border-radius: 50%;\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -400px) scale(1);\r\n  animation: bounce 3s ease-in-out forwards;\r\n}\r\n\r\n@keyframes bounce {\r\n  0% {\r\n    top: -200px;\r\n    transform: translateX(-50%);\r\n  }\r\n  20% {\r\n    top: 50%;\r\n    transform: translateX(-50%) scale(1.1);\r\n  }\r\n  35% {\r\n    transform: translateX(-50%) scale(0.8);\r\n  }\r\n  50% {\r\n    transform: translateX(-50%) scale(1.25);\r\n  }\r\n  65% {\r\n    transform: translateX(-50%) scale(0.95);\r\n  }\r\n  100% {\r\n    top: 50%;\r\n    transform: translate(-50%) scale(40);\r\n  }\r\n}\r\n\r\n.bola-hide-button {\r\n  animation: bolaNaik 0.5s ease-in-out forwards;\r\n}\r\n\r\n@keyframes bolaNaik {\r\n  0% {\r\n    top: 50%;\r\n    transform: translate(-50%, -50%) scale(40);\r\n  }\r\n  100% {\r\n    top: -66%;\r\n    transform: translate(-50%, -50%) scale(40);\r\n  }\r\n}\r\n\r\n.konten {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -20%);\r\n  text-align: center;\r\n  opacity: 0;\r\n  animation: tampilKonten 6s ease-in-out forwards;\r\n}\r\n\r\n@keyframes tampilKonten {\r\n  0% {\r\n    opacity: 0;\r\n  }\r\n  20% {\r\n    opacity: 1;\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n.foto {\r\n  width: 300px;\r\n  height: 300px;\r\n  object-fit: cover;\r\n  opacity: 0;\r\n  z-index: 2;\r\n  animation: animFoto 2s ease-in-out forwards;\r\n  animation-delay: 1.87s;\r\n}\r\n\r\n@keyframes animFoto {\r\n  0%,\r\n  10% {\r\n    opacity: 0;\r\n    transform: translateY(0) scale(1);\r\n  }\r\n  30%,\r\n  70% {\r\n    opacity: 1;\r\n    transform: translateY(0) scale(1);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    transform: translateY(-95px) scale(0.73);\r\n  }\r\n}\r\n\r\n.foto-animasi2 {\r\n  animation: fotoNaik 0.5s ease-in-out forwards;\r\n}\r\n\r\n@keyframes fotoNaik {\r\n  0% {\r\n    opacity: 1;\r\n    transform: translateY(-95px) scale(0.73);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    transform: translateY(-230px) scale(0.49);\r\n  }\r\n}\r\n\r\n.button-mulai {\r\n  position: relative;\r\n  top: 60px;\r\n}\r\n\r\n.mulai {\r\n  padding: 8px 25px;\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  border: 1.5px solid #3367d6;\r\n  border-radius: 8px;\r\n  background-color: #6581dd;\r\n  color: #ffffff;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  opacity: 0;\r\n  transform: translateY(100px);\r\n  animation: tampilTombol 1s ease-in-out forwards;\r\n  animation-delay: 3s;\r\n}\r\n\r\n@keyframes tampilTombol {\r\n  0% {\r\n    opacity: 0;\r\n    transform: translateY(100px);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n.mulai:hover {\r\n  background-color: #3367d6;\r\n}\r\n\r\n.hide-button {\r\n  opacity: 0;\r\n  display: none;\r\n}\r\n\r\n/* ========================= LOGIN ========================= */\r\n.login {\r\n  position: absolute;\r\n  top: 110%;\r\n  left: 50%;\r\n  transform: translate(-50%, 0);\r\n  text-align: center;\r\n  width: 100%;\r\n  opacity: 0;\r\n  z-index: 2;\r\n  transition: all 0.8s ease-in-out;\r\n}\r\n\r\n.login.show {\r\n  top: 55%;\r\n  transform: translate(-50%, -50%);\r\n  opacity: 1;\r\n}\r\n\r\n.login.hide {\r\n  opacity: 0;\r\n  transform: translate(-50%, 50%);\r\n  pointer-events: none;\r\n}\r\n\r\n.login h2 {\r\n  margin: 29px 0;\r\n  font-weight: 500;\r\n  font-size: 36px;\r\n  color: #1a2dbf;\r\n}\r\n\r\n.login .input-container {\r\n  position: relative;\r\n  width: 300px;\r\n  margin: 10px auto;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.login .input-container i {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50px;\r\n  transform: translateY(-50%);\r\n  color: #1a2dbf;\r\n  font-size: 16px;\r\n}\r\n\r\n.login .input-container input {\r\n  width: 80%;\r\n  padding: 14px 16px 14px 45px;\r\n  border-radius: 8px;\r\n  border: 1px solid #000000;\r\n  outline: none;\r\n  font-size: 15px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.login button {\r\n  width: 110px;\r\n  padding: 10px;\r\n  background-color: #2b4ae4;\r\n  border: none;\r\n  color: #ffffff;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  margin-top: 10px;\r\n  font-weight: bold;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.login button:hover {\r\n  background-color: #2039b8;\r\n}\r\n\r\n.login p {\r\n  margin-top: 10px;\r\n  font-size: 14px;\r\n}\r\n\r\n.login a {\r\n  color: #1a2dbf;\r\n  text-decoration: none;\r\n  font-weight: 500;\r\n}\r\n\r\n.login a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n/* ========================= REGISTER ========================= */\r\n.register {\r\n  position: absolute;\r\n  top: 120%;\r\n  left: 50%;\r\n  transform: translate(-50%, 0);\r\n  text-align: center;\r\n  width: 1