{"ast":null,"code":"export default {\n  name: \"RegisterPage\",\n  methods: {\n    goRegister() {\n      alert(\"Register ditekan!\");\n    }\n  }\n};","map":{"version":3,"names":["name","methods","goRegister","alert"],"sources":["C:\\xampp\\htdocs\\fahry-project\\src\\pages\\register.vue"],"sourcesContent":["<template>\r\n  <!-- Font Awesome -->\r\n  <link\r\n    rel=\"stylesheet\"\r\n    href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css\"\r\n  />\r\n\r\n  <div class=\"page-wrapper\">\r\n\r\n    <!-- Bagian Kiri (Register Form) -->\r\n    <div class=\"left-panel\">\r\n      <h1 class=\"title\">Register</h1>\r\n\r\n      <div class=\"input-box\">\r\n        <i class=\"fa-solid fa-envelope icon\"></i>\r\n        <input type=\"email\" placeholder=\"Email\" />\r\n      </div>\r\n\r\n      <div class=\"input-box\">\r\n        <i class=\"fa-solid fa-user icon\"></i>\r\n        <input type=\"text\" placeholder=\"Username\" />\r\n      </div>\r\n\r\n      <div class=\"input-box\">\r\n        <i class=\"fa-solid fa-lock icon\"></i>\r\n        <input type=\"password\" placeholder=\"Password\" />\r\n      </div>\r\n\r\n      <div class=\"input-box\">\r\n        <i class=\"fa-solid fa-key icon\"></i>\r\n        <input type=\"password\" placeholder=\"Konfirmasi\" />\r\n      </div>\r\n\r\n      <button class=\"btn-masuk\" @click=\"goRegister\">Masuk</button>\r\n\r\n      <p class=\"login-text\">\r\n        Sudah punya akun?\r\n        <router-link to=\"/login\" class=\"link-login\">Login</router-link>\r\n      </p>\r\n    </div>\r\n\r\n    <!-- Bagian Kanan (Gambar + Logo + Text) -->\r\n    <div class=\"right-panel\">\r\n      <!-- Logo kanan atas -->\r\n      <img :src=\"require('@/assets/scream.png')\" class=\"logo\" />\r\n\r\n      <!-- Ilustrasi utama -->\r\n      <img :src=\"require('@/assets/regis.png')\" class=\"image-hero\" />\r\n\r\n      <p class=\"welcome-text\">\r\n        Start your life with a better experience\r\n      </p>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"RegisterPage\",\r\n\r\n  methods: {\r\n    goRegister() {\r\n      alert(\"Register ditekan!\");\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n/* ===== Layout Utama ===== */\r\n.page-wrapper {\r\n  display: flex;\r\n  width: 100%;\r\n  min-height: 100vh;\r\n  background: #0e063c;\r\n}\r\n\r\n/* ===== Panel Kiri ===== */\r\n.left-panel {\r\n  width: 45%;\r\n  background: #ffffff;\r\n  border-radius: 40px;\r\n  margin: 40px;\r\n  padding: 60px;\r\n  box-shadow: 0 0 20px #0000002a;\r\n}\r\n\r\n.title {\r\n  font-size: 64px;\r\n  font-weight: 800;\r\n  color: #3729da;\r\n  margin-bottom: 40px;\r\n}\r\n\r\n/* Input Box */\r\n.input-box {\r\n  width: 100%;\r\n  height: 55px;\r\n  border: 1px solid #b8b8b8;\r\n  border-radius: 30px;\r\n  margin-bottom: 20px;\r\n  padding-left: 50px;\r\n  position: relative;\r\n}\r\n\r\n.input-box input {\r\n  width: 100%;\r\n  height: 100%;\r\n  border: none;\r\n  outline: none;\r\n  font-size: 18px;\r\n  padding-right: 20px;\r\n}\r\n\r\n.icon {\r\n  position: absolute;\r\n  left: 18px;\r\n  top: 16px;\r\n  font-size: 20px;\r\n  color: #4d5183;\r\n}\r\n\r\n/* Tombol */\r\n.btn-masuk {\r\n  width: 180px;\r\n  height: 50px;\r\n  background: #4f5999;\r\n  border-radius: 20px;\r\n  border: none;\r\n  font-size: 20px;\r\n  color: white;\r\n  margin-top: 10px;\r\n  cursor: pointer;\r\n  font-weight: bold;\r\n}\r\n\r\n/* Login text */\r\n.login-text {\r\n  margin-top: 15px;\r\n  font-size: 18px;\r\n}\r\n\r\n.link-login {\r\n  color: #0C2DFF;\r\n  font-weight: bold;\r\n}\r\n\r\n/* ===== Panel Kanan ===== */\r\n.right-panel {\r\n  width: 55%;\r\n  position: relative;\r\n  text-align: center;\r\n}\r\n\r\n.logo {\r\n  width: 220px;\r\n  position: absolute;\r\n  top: 40px;\r\n  right: 40px;\r\n}\r\n\r\n.image-hero {\r\n  width: 65%;\r\n  margin-top: 130px;\r\n}\r\n\r\n.welcome-text {\r\n  font-size: 30px;\r\n  color: white;\r\n  font-weight: 600;\r\n  margin-top: 20px;\r\n}\r\n</style>\r\n"],"mappings":"AA0DA,eAAe;EACbA,IAAI,EAAE,cAAc;EAEpBC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACXC,KAAK,CAAC,mBAAmB,CAAC;IAC5B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}