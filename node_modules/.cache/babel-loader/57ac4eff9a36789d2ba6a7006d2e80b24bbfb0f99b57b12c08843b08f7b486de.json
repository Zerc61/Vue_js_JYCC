{"ast":null,"code":"export default {\n  name: \"RegisterPage\",\n  methods: {\n    goRegister() {\n      // Perhatikan: Dalam aplikasi nyata, jangan gunakan alert()\n      alert(\"Masuk (Register) ditekan! Proses registrasi...\");\n    }\n  }\n};","map":{"version":3,"names":["name","methods","goRegister","alert"],"sources":["C:\\xampp\\htdocs\\fahry-project\\src\\pages\\register.vue"],"sourcesContent":["<template>\r\n  <div class=\"sign-in-desktop\">\r\n    \r\n    <!-- Konten Kiri: Form Registrasi -->\r\n    <div class=\"form-container\">\r\n      <div class=\"sign-in-title\">Sign-in</div>\r\n\r\n      <!-- Email -->\r\n      <div class=\"input-field form-email\">\r\n        <div class=\"input-box\"></div>\r\n        <!-- Menggunakan elemen <input> yang di-overlay dengan placeholder untuk fungsionalitas -->\r\n        <i class=\"fa-solid fa-envelope icon\"></i>\r\n        <input type=\"email\" placeholder=\"Email\" class=\"input-text\" />\r\n      </div>\r\n\r\n      <!-- Username -->\r\n      <div class=\"input-field form-username\">\r\n        <div class=\"input-box\"></div>\r\n        <i class=\"fa-solid fa-user icon\"></i>\r\n        <input type=\"text\" placeholder=\"Username\" class=\"input-text\" />\r\n      </div>\r\n\r\n      <!-- Password -->\r\n      <div class=\"input-field form-password\">\r\n        <div class=\"input-box\"></div>\r\n        <i class=\"fa-solid fa-lock icon\"></i>\r\n        <input type=\"password\" placeholder=\"Password\" class=\"input-text\" />\r\n      </div>\r\n\r\n      <!-- Konfirmasi Password / Konfirmasi -->\r\n      <div class=\"input-field form-konfirmasi\">\r\n        <div class=\"input-box\"></div>\r\n        <i class=\"fa-solid fa-key icon\"></i>\r\n        <input type=\"password\" placeholder=\"Konfirmasi\" class=\"input-text\" />\r\n      </div>\r\n\r\n      <!-- Tombol Masuk (seharusnya Daftar/Register di konteks ini, tetapi saya mengikuti teks di gambar: \"Masuk\") -->\r\n      <div class=\"btn-masuk\" @click=\"goRegister\">\r\n        <div class=\"button-box\"></div>\r\n        <div class=\"button-text\">Masuk</div>\r\n      </div>\r\n\r\n      <!-- Link Login -->\r\n      <div class=\"signup-link-container\">\r\n        <div class=\"signup-text\">Sudah punya akun?</div>\r\n        <router-link to=\"/login\" class=\"signup-link\">Login</router-link>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Konten Kanan: Ilustrasi dan Slogan -->\r\n    <div class=\"illustration-section\">\r\n      <!-- Header Aplikasi (Logo dan Nama) -->\r\n      <div class=\"app-header\">\r\n        <!-- CATATAN: Ganti path gambar sesuai lokasi aset Anda -->\r\n        <img :src=\"require('@/assets/scream.png')\" alt=\"Logo\" class=\"app-logo\" />\r\n        <div class=\"app-name\">SCREAM DESTINATION</div>\r\n      </div>\r\n      \r\n      <!-- Ilustrasi Orang dan Gunung -->\r\n      <!-- CATATAN: Ganti path gambar sesuai lokasi aset Anda -->\r\n      <img :src=\"require('@/assets/regis.png')\" alt=\"Illustrasi Traveler\" class=\"traveler-illustration\" />\r\n      \r\n      <!-- Teks Slogan -->\r\n      <div class=\"slogan-text\">\r\n        Start your life with a better experience\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"RegisterPage\",\r\n  methods: {\r\n    goRegister() {\r\n      // Perhatikan: Dalam aplikasi nyata, jangan gunakan alert()\r\n      alert(\"Masuk (Register) ditekan! Proses registrasi...\"); \r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Pastikan Anda telah mengimpor Font Awesome CSS di file utama HTML (index.html) atau di file global CSS Anda, contoh:\r\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\" />\r\n*/\r\n\r\n/* Styling keseluruhan kontainer utama */\r\n.sign-in-desktop {\r\n  /* Warna latar belakang ungu gelap */\r\n  background-color: #2a1979; \r\n  min-height: 1024px;\r\n  min-width: 1440px;\r\n  position: relative;\r\n  display: flex; \r\n  overflow: hidden;\r\n  font-family: sans-serif;\r\n}\r\n\r\n/* --- Bagian Kiri (Form Registrasi) --- */\r\n\r\n.form-container {\r\n  background-color: #ffffff;\r\n  border-radius: 62px;\r\n  height: 850px;\r\n  width: 646px;\r\n  position: absolute; \r\n  left: 30px; /* Positioned on the left */\r\n  top: 26px;\r\n  /* Centering content within the form */\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  padding-top: 150px;\r\n}\r\n\r\n/* Judul Sign-in (Registrasi) */\r\n.sign-in-title {\r\n  font-size: 96px; \r\n  color: #3729da; /* Biru terang */\r\n  font-weight: bold;\r\n  position: absolute;\r\n  top: 92px;\r\n  left: 170px;\r\n}\r\n\r\n/* Penempatan Field Input */\r\n.input-field {\r\n  height: 53px;\r\n  width: 434px; \r\n  margin-bottom: 30px;\r\n  position: relative;\r\n  left: 0px; /* Disesuaikan agar input field berada di tengah form */\r\n}\r\n\r\n/* Penempatan spesifik (disesuaikan dari posisi absolut ke posisi relatif) */\r\n.form-email { margin-top: 10px; } /* Mulai dari atas */\r\n.form-username { margin-top: 10px; } \r\n.form-password { margin-top: 10px; }\r\n.form-konfirmasi { margin-top: 10px; }\r\n\r\n/* Kotak Input Visual */\r\n.input-box {\r\n  background-color: #ffffff;\r\n  border: 1px solid #000;\r\n  border-radius: 22px;\r\n  height: 53px;\r\n  width: 434px;\r\n}\r\n\r\n/* Icon di dalam input */\r\n.icon {\r\n  font-size: 22px;\r\n  color: #4d5183; \r\n  position: absolute;\r\n  left: 20px;\r\n  top: 15px;\r\n  z-index: 10;\r\n}\r\n\r\n/* Input teks sesungguhnya */\r\n.input-text {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  border: none;\r\n  background: transparent;\r\n  padding: 0 20px 0 65px; /* Padding untuk ikon dan teks */\r\n  border-radius: 22px;\r\n  font-size: 18px;\r\n  color: #4d5183;\r\n}\r\n.input-text:focus {\r\n    outline: none; /* Hapus outline saat fokus */\r\n}\r\n\r\n/* Tombol Masuk */\r\n.btn-masuk {\r\n  margin-top: 30px;\r\n  cursor: pointer;\r\n  position: relative; \r\n  left: 0; /* Dikoreksi agar tombol berada di tengah */\r\n}\r\n\r\n.button-box {\r\n  background-color: #4f5999; \r\n  border-radius: 19px;\r\n  height: 53px;\r\n  width: 176px;\r\n}\r\n\r\n.button-text {\r\n  color: white;\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  font-weight: bold;\r\n  font-size: 20px;\r\n  width: 100%;\r\n  text-align: center;\r\n}\r\n\r\n/* Link Login */\r\n.signup-link-container {\r\n  display: flex;\r\n  gap: 5px;\r\n  margin-top: 30px;\r\n  font-size: 18px;\r\n}\r\n\r\n.signup-text {\r\n  color: #000;\r\n}\r\n\r\n.signup-link {\r\n  color: #0004ff;\r\n  cursor: pointer;\r\n  text-decoration: underline;\r\n  font-weight: 500;\r\n}\r\n\r\n/* --- Bagian Kanan (Ilustrasi) --- */\r\n\r\n.illustration-section {\r\n  position: absolute;\r\n  right: 0; \r\n  top: 0;\r\n  /* Perkiraan lebar bagian kanan */\r\n  width: 764px; \r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n/* Header Aplikasi (Logo dan Nama) */\r\n.app-header {\r\n  position: absolute;\r\n  top: 80px;\r\n  left: 100px; \r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n}\r\n\r\n.app-logo {\r\n  /* Asumsi gambar ikon logo SCREAM DESTINATION */\r\n  width: 40px; \r\n  height: auto;\r\n}\r\n\r\n.app-name {\r\n  color: white;\r\n  font-size: 20px;\r\n  font-weight: bold;\r\n  margin-left: 10px;\r\n}\r\n\r\n/* Ilustrasi Orang dan Gunung */\r\n.traveler-illustration {\r\n  /* Posisikan ilustrasi traveler */\r\n  width: 450px; \r\n  height: auto;\r\n  margin-top: -50px; \r\n}\r\n\r\n/* Teks Slogan/Welcome */\r\n.slogan-text {\r\n  position: absolute;\r\n  bottom: 120px; \r\n  color: #ffffff;\r\n  font-size: 32px;\r\n  font-weight: 600;\r\n  text-align: center;\r\n  width: 70%;\r\n}\r\n</style>"],"mappings":"AAuEA,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX;MACAC,KAAK,CAAC,gDAAgD,CAAC;IACzD;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}