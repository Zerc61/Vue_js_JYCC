{"ast":null,"code":"export default {\n  name: \"LoginPage\",\n  methods: {\n    mulaiLogin() {\n      const bola = document.querySelector(\".bola\");\n      const tombol = document.querySelector(\".mulai\");\n      const foto = document.querySelector(\".foto\");\n      const login = document.querySelector(\".login\");\n      tombol.classList.add(\"hide-button\");\n      bola.classList.add(\"bola-hide-button\");\n      foto.classList.add(\"foto-animasi2\");\n      setTimeout(() => {\n        login.classList.add(\"show\");\n      }, 100);\n    },\n    mulaiRegister(event) {\n      event.preventDefault();\n      const login = document.getElementById(\"loginForm\");\n      const register = document.getElementById(\"registerForm\");\n      login.classList.remove(\"show\");\n      login.classList.add(\"hide\");\n      setTimeout(() => {\n        register.classList.remove(\"hide\");\n        register.classList.add(\"show\");\n      }, 400);\n    },\n    kembaliLogin(event) {\n      event.preventDefault();\n      const login = document.getElementById(\"loginForm\");\n      const register = document.getElementById(\"registerForm\");\n      register.classList.remove(\"show\");\n      register.classList.add(\"hide\");\n      setTimeout(() => {\n        login.classList.remove(\"hide\");\n        login.classList.add(\"show\");\n      }, 400);\n    }\n  }\n};","map":{"version":3,"names":["name","methods","mulaiLogin","bola","document","querySelector","tombol","foto","login","classList","add","setTimeout","mulaiRegister","event","preventDefault","getElementById","register","remove","kembaliLogin"],"sources":["C:\\xampp\\htdocs\\fahry-project\\src\\pages\\login.vue"],"sourcesContent":["<template>\r\n  <div class=\"wrapper\">\r\n\r\n    <div class=\"bola\"></div>\r\n\r\n    <div class=\"konten\">\r\n      <img :src=\"require('@/assets/scream.png')\" alt=\"\" class=\"foto\" />\r\n      <div class=\"button-mulai\">\r\n        <button class=\"mulai\" @click=\"mulaiLogin\">Mulai</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- LOGIN FORM -->\r\n    <div class=\"login\" id=\"loginForm\">\r\n      <div class=\"form-container\">\r\n        <h2>Log - in</h2>\r\n        <form>\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-envelope\"></i>\r\n            <input type=\"email\" placeholder=\"Email\" />\r\n          </div>\r\n\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-lock\"></i>\r\n            <input type=\"password\" placeholder=\"Password\" />\r\n          </div>\r\n\r\n          <button type=\"button\">Masuk</button>\r\n\r\n          <p>\r\n            Belum punya akun?\r\n            <a href=\"#\" @click.prevent=\"mulaiRegister\">Register</a>\r\n          </p>\r\n\r\n          <div class=\"social-login\">\r\n            <div class=\"divider\">Atau</div>\r\n\r\n            <div class=\"social-icons\">\r\n              <i class=\"fa-brands fa-google\"></i>\r\n              <i class=\"fa-brands fa-twitter\"></i>\r\n              <i class=\"fa-brands fa-facebook\"></i>\r\n            </div>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- REGISTER FORM -->\r\n    <div class=\"register\" id=\"registerForm\">\r\n      <div class=\"form-container\">\r\n        <h2>Register</h2>\r\n        <form>\r\n\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-user\"></i>\r\n            <input type=\"text\" placeholder=\"Nama Lengkap\" />\r\n          </div>\r\n\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-envelope\"></i>\r\n            <input type=\"email\" placeholder=\"Email\" />\r\n          </div>\r\n\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-lock\"></i>\r\n            <input type=\"password\" placeholder=\"Password\" />\r\n          </div>\r\n\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-lock\"></i>\r\n            <input type=\"password\" placeholder=\"Konfirmasi Password\" />\r\n          </div>\r\n\r\n          <button type=\"button\">Daftar</button>\r\n\r\n          <p>\r\n            Sudah punya akun?\r\n            <a href=\"#\" @click.prevent=\"kembaliLogin\">Login</a>\r\n          </p>\r\n        </form>\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"LoginPage\",\r\n\r\n  methods: {\r\n    mulaiLogin() {\r\n      const bola = document.querySelector(\".bola\");\r\n      const tombol = document.querySelector(\".mulai\");\r\n      const foto = document.querySelector(\".foto\");\r\n      const login = document.querySelector(\".login\");\r\n\r\n      tombol.classList.add(\"hide-button\");\r\n      bola.classList.add(\"bola-hide-button\");\r\n      foto.classList.add(\"foto-animasi2\");\r\n\r\n      setTimeout(() => {\r\n        login.classList.add(\"show\");\r\n      }, 100);\r\n    },\r\n\r\n    mulaiRegister(event) {\r\n      event.preventDefault();\r\n      const login = document.getElementById(\"loginForm\");\r\n      const register = document.getElementById(\"registerForm\");\r\n\r\n      login.classList.remove(\"show\");\r\n      login.classList.add(\"hide\");\r\n\r\n      setTimeout(() => {\r\n        register.classList.remove(\"hide\");\r\n        register.classList.add(\"show\");\r\n      }, 400);\r\n    },\r\n\r\n    kembaliLogin(event) {\r\n      event.preventDefault();\r\n      const login = document.getElementById(\"loginForm\");\r\n      const register = document.getElementById(\"registerForm\");\r\n\r\n      register.classList.remove(\"show\");\r\n      register.classList.add(\"hide\");\r\n\r\n      setTimeout(() => {\r\n        login.classList.remove(\"hide\");\r\n        login.classList.add(\"show\");\r\n      }, 400);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style>\r\n\r\n/* ==== Desktop Wrapper ==== */\r\n.wrapper {\r\n  width: 100%;\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  background: #ffffff;\r\n  font-family: \"Kanit\", sans-serif;\r\n}\r\n\r\n/* ==== DESKTOP IMPROVEMENT ==== */\r\n.form-container {\r\n  background: white;\r\n  padding: 35px 50px;\r\n  width: 420px;\r\n  margin: auto;\r\n  border-radius: 16px;\r\n  box-shadow: 0 4px 24px rgba(0,0,0,0.1);\r\n}\r\n\r\n/* ==== Perbaikan ukuran untuk desktop ==== */\r\n.login h2,\r\n.register h2 {\r\n  font-size: 42px; /* lebih besar */\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.login .input-container input,\r\n.register .input-container input {\r\n  width: 100%;\r\n  font-size: 16px;\r\n}\r\n\r\n.login button,\r\n.register button {\r\n  width: 150px; \r\n  padding: 12px;\r\n  font-size: 16px;\r\n  border-radius: 10px;\r\n}\r\n\r\n/* ==== posisi login/register lebih tinggi di desktop ==== */\r\n.login.show {\r\n  top: 50%;\r\n}\r\n\r\n.register.show {\r\n  top: 50%;\r\n}\r\n\r\n/* ==== sisanya tetap sama ==== */\r\n</style>\r\n"],"mappings":"AAuFA,eAAe;EACbA,IAAI,EAAE,WAAW;EAEjBC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX,MAAMC,IAAG,GAAIC,QAAQ,CAACC,aAAa,CAAC,OAAO,CAAC;MAC5C,MAAMC,MAAK,GAAIF,QAAQ,CAACC,aAAa,CAAC,QAAQ,CAAC;MAC/C,MAAME,IAAG,GAAIH,QAAQ,CAACC,aAAa,CAAC,OAAO,CAAC;MAC5C,MAAMG,KAAI,GAAIJ,QAAQ,CAACC,aAAa,CAAC,QAAQ,CAAC;MAE9CC,MAAM,CAACG,SAAS,CAACC,GAAG,CAAC,aAAa,CAAC;MACnCP,IAAI,CAACM,SAAS,CAACC,GAAG,CAAC,kBAAkB,CAAC;MACtCH,IAAI,CAACE,SAAS,CAACC,GAAG,CAAC,eAAe,CAAC;MAEnCC,UAAU,CAAC,MAAM;QACfH,KAAK,CAACC,SAAS,CAACC,GAAG,CAAC,MAAM,CAAC;MAC7B,CAAC,EAAE,GAAG,CAAC;IACT,CAAC;IAEDE,aAAaA,CAACC,KAAK,EAAE;MACnBA,KAAK,CAACC,cAAc,CAAC,CAAC;MACtB,MAAMN,KAAI,GAAIJ,QAAQ,CAACW,cAAc,CAAC,WAAW,CAAC;MAClD,MAAMC,QAAO,GAAIZ,QAAQ,CAACW,cAAc,CAAC,cAAc,CAAC;MAExDP,KAAK,CAACC,SAAS,CAACQ,MAAM,CAAC,MAAM,CAAC;MAC9BT,KAAK,CAACC,SAAS,CAACC,GAAG,CAAC,MAAM,CAAC;MAE3BC,UAAU,CAAC,MAAM;QACfK,QAAQ,CAACP,SAAS,CAACQ,MAAM,CAAC,MAAM,CAAC;QACjCD,QAAQ,CAACP,SAAS,CAACC,GAAG,CAAC,MAAM,CAAC;MAChC,CAAC,EAAE,GAAG,CAAC;IACT,CAAC;IAEDQ,YAAYA,CAACL,KAAK,EAAE;MAClBA,KAAK,CAACC,cAAc,CAAC,CAAC;MACtB,MAAMN,KAAI,GAAIJ,QAAQ,CAACW,cAAc,CAAC,WAAW,CAAC;MAClD,MAAMC,QAAO,GAAIZ,QAAQ,CAACW,cAAc,CAAC,cAAc,CAAC;MAExDC,QAAQ,CAACP,SAAS,CAACQ,MAAM,CAAC,MAAM,CAAC;MACjCD,QAAQ,CAACP,SAAS,CAACC,GAAG,CAAC,MAAM,CAAC;MAE9BC,UAAU,CAAC,MAAM;QACfH,KAAK,CAACC,SAAS,CAACQ,MAAM,CAAC,MAAM,CAAC;QAC9BT,KAAK,CAACC,SAAS,CAACC,GAAG,CAAC,MAAM,CAAC;MAC7B,CAAC,EAAE,GAAG,CAAC;IACT;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}