{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"LoginView\",\n  data() {\n    return {\n      email: \"\",\n      password: \"\",\n      showPass: false,\n      feedback: {\n        message: \"\",\n        ok: false\n      }\n    };\n  },\n  methods: {\n    async handleLogin() {\n      this.feedback = {\n        message: \"\",\n        ok: false\n      };\n\n      // Simulasi API login\n      const result = await this.fakeAuth(this.email.trim(), this.password);\n      if (result.ok) {\n        this.feedback = {\n          message: \"Login berhasil. Mengalihkan...\",\n          ok: true\n        };\n        sessionStorage.setItem(\"demo_token\", result.token);\n        setTimeout(() => {\n          this.$router.push(\"/dashboard\");\n        }, 800);\n      } else {\n        this.feedback = {\n          message: result.message,\n          ok: false\n        };\n      }\n    },\n    fakeAuth(email, pass) {\n      return new Promise(resolve => {\n        setTimeout(() => {\n          if (email === \"user@test.local\" && pass === \"password123\") {\n            resolve({\n              ok: true,\n              token: \"demo_token_abc123\"\n            });\n          } else {\n            resolve({\n              ok: false,\n              message: \"Email atau kata sandi salah.\"\n            });\n          }\n        }, 600);\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","email","password","showPass","feedback","message","ok","methods","handleLogin","result","fakeAuth","trim","sessionStorage","setItem","token","setTimeout","$router","push","pass","Promise","resolve"],"sources":["C:\\laragon\\www\\FrontEndDcoin_JYCC\\src\\pages\\login.vue"],"sourcesContent":["<template>\r\n  <div class=\"min-h-screen bg-slate-900 flex items-center justify-center p-6\">\r\n    <div class=\"w-full max-w-md bg-slate-800/40 backdrop-blur rounded-2xl p-6 shadow-xl\">\r\n      <div class=\"flex items-center gap-3 mb-4\">\r\n        <div class=\"w-12 h-12 rounded-lg bg-emerald-300 flex items-center justify-center font-bold text-slate-800\">LB</div>\r\n        <div>\r\n          <h1 class=\"text-lg font-semibold text-white\">Masuk ke Akun Anda</h1>\r\n          <p class=\"text-slate-400 text-sm\">Masukkan email dan kata sandi untuk melanjutkan.</p>\r\n        </div>\r\n      </div>\r\n\r\n      <form @submit.prevent=\"handleLogin\" class=\"grid gap-4\">\r\n        <div>\r\n          <label class=\"text-slate-300 text-sm\" for=\"email\">Email</label>\r\n          <input\r\n            v-model=\"email\"\r\n            type=\"email\"\r\n            id=\"email\"\r\n            class=\"w-full mt-1 p-3 rounded-xl bg-slate-900 border border-slate-700 text-slate-200\"\r\n            placeholder=\"nama@contoh.com\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <div>\r\n          <label class=\"text-slate-300 text-sm\" for=\"password\">Kata Sandi</label>\r\n          <div class=\"relative mt-1\">\r\n            <input\r\n              v-model=\"password\"\r\n              :type=\"showPass ? 'text' : 'password'\"\r\n              id=\"password\"\r\n              class=\"w-full p-3 rounded-xl bg-slate-900 border border-slate-700 text-slate-200\"\r\n              placeholder=\"Minimal 6 karakter\"\r\n              required\r\n              minlength=\"6\"\r\n            />\r\n            <button\r\n              type=\"button\"\r\n              @click=\"showPass = !showPass\"\r\n              class=\"absolute right-3 top-3 text-slate-400\"\r\n            >{{ showPass ? 'S' : 'T' }}</button>\r\n          </div>\r\n        </div>\r\n\r\n        <div v-if=\"feedback.message\" :class=\"feedback.ok ? 'text-emerald-400' : 'text-red-400'\">\r\n          {{ feedback.message }}\r\n        </div>\r\n\r\n        <button\r\n          type=\"submit\"\r\n          class=\"w-full bg-emerald-300 text-slate-900 font-bold p-3 rounded-xl hover:bg-emerald-400 transition\"\r\n        >Masuk</button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"LoginView\",\r\n  data() {\r\n    return {\r\n      email: \"\",\r\n      password: \"\",\r\n      showPass: false,\r\n      feedback: { message: \"\", ok: false },\r\n    };\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      this.feedback = { message: \"\", ok: false };\r\n\r\n      // Simulasi API login\r\n      const result = await this.fakeAuth(this.email.trim(), this.password);\r\n\r\n      if (result.ok) {\r\n        this.feedback = { message: \"Login berhasil. Mengalihkan...\", ok: true };\r\n        sessionStorage.setItem(\"demo_token\", result.token);\r\n\r\n        setTimeout(() => {\r\n          this.$router.push(\"/dashboard\");\r\n        }, 800);\r\n      } else {\r\n        this.feedback = { message: result.message, ok: false };\r\n      }\r\n    },\r\n\r\n    fakeAuth(email, pass) {\r\n      return new Promise((resolve) => {\r\n        setTimeout(() => {\r\n          if (email === \"user@test.local\" && pass === \"password123\") {\r\n            resolve({ ok: true, token: \"demo_token_abc123\" });\r\n          } else {\r\n            resolve({ ok: false, message: \"Email atau kata sandi salah.\" });\r\n          }\r\n        }, 600);\r\n      });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\nbody {\r\n  font-family: Inter, sans-serif;\r\n}\r\n</style>\r\n"],"mappings":";AA0DA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE,KAAK;MACfC,QAAQ,EAAE;QAAEC,OAAO,EAAE,EAAE;QAAEC,EAAE,EAAE;MAAM;IACrC,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACJ,QAAO,GAAI;QAAEC,OAAO,EAAE,EAAE;QAAEC,EAAE,EAAE;MAAM,CAAC;;MAE1C;MACA,MAAMG,MAAK,GAAI,MAAM,IAAI,CAACC,QAAQ,CAAC,IAAI,CAACT,KAAK,CAACU,IAAI,CAAC,CAAC,EAAE,IAAI,CAACT,QAAQ,CAAC;MAEpE,IAAIO,MAAM,CAACH,EAAE,EAAE;QACb,IAAI,CAACF,QAAO,GAAI;UAAEC,OAAO,EAAE,gCAAgC;UAAEC,EAAE,EAAE;QAAK,CAAC;QACv