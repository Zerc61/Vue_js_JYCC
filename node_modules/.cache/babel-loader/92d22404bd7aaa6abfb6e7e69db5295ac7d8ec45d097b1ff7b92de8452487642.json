{"ast":null,"code":"export default {\n  name: \"LoginPage\"\n};","map":{"version":3,"names":["name"],"sources":["C:\\xampp\\htdocs\\fahry-project\\src\\pages\\login.vue"],"sourcesContent":["<template>\r\n\r\n  <div class=\"bola\"></div>\r\n\r\n  <div class=\"konten\">\r\n    <img src=\"SCREAM DESNITATION (4).png\" alt=\"\" class=\"foto\" />\r\n    <div class=\"button-mulai\">\r\n      <button class=\"mulai\" onclick=\"mulaiLogin()\">Mulai</button>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"login\" id=\"loginForm\">\r\n    <h2>Log - in</h2>\r\n    <form action=\"\">\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-envelope\"></i>\r\n        <input type=\"email\" placeholder=\"Email\" />\r\n      </div>\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-lock\"></i>\r\n        <input type=\"password\" placeholder=\"Password\" />\r\n      </div>\r\n      <button type=\"button\">Masuk</button>\r\n      <p>Belum punya akun? <a href=\"#\" onclick=\"mulaiRegister(event)\">Register</a></p>\r\n      <div class=\"social-login\">\r\n        <div class=\"divider\">Atau</div>\r\n        <div class=\"social-icons\">\r\n          <i class=\"fa-brands fa-google\"></i>\r\n          <i class=\"fa-brands fa-twitter\"></i>\r\n          <i class=\"fa-brands fa-facebook\"></i>\r\n        </div>\r\n      </div>\r\n    </form>\r\n  </div>\r\n\r\n  <div class=\"register\" id=\"registerForm\">\r\n    <h2>Register</h2>\r\n    <form action=\"\">\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-user\"></i>\r\n        <input type=\"text\" placeholder=\"Nama Lengkap\" />\r\n      </div>\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-envelope\"></i>\r\n        <input type=\"email\" placeholder=\"Email\" />\r\n      </div>\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-lock\"></i>\r\n        <input type=\"password\" placeholder=\"Password\" />\r\n      </div>\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-lock\"></i>\r\n        <input type=\"password\" placeholder=\"Konfirmasi Password\" />\r\n      </div>\r\n      <button type=\"button\">Daftar</button>\r\n      <p>Sudah punya akun? <a href=\"#\" onclick=\"kembaliLogin(event)\">Login</a></p>\r\n    </form>\r\n  </div>\r\n\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    name: \"LoginPage\"\r\n};\r\n</script>\r\n\r\n<style>\r\n/* Tampilkan keseluruhan */\r\n.login-page {\r\n    height: 100vh;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    background: linear-gradient(135leg, #085678, #0aa1dd);\r\n    font-family: \"poppins\", sans-serif;\r\n}\r\n\r\n/* kartu login */\r\n.login-card {\r\n    background: #fff;\r\n    padding: 30px 40px;\r\n    border-radius: 15px;\r\n    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);\r\n    width: 320px;\r\n}\r\n\r\n/* judul */\r\n.title {\r\n    text-align: center;\r\n    color: #085675;\r\n    margin-bottom: 25px;\r\n}\r\n\r\n/* label dan input */\r\n.form-group {\r\n    margin-bottom: 20px;\r\n}\r\n\r\nlabel {\r\n    display: block;\r\n    margin-bottom: 5px;\r\n    font-weight: 600;\r\n    color: #333;\r\n}\r\n\r\ninput {\r\n    width: 100%;\r\n    padding: 10px;\r\n    border: 1px solid #bbb;\r\n    border-radius: 8px;\r\n    outline: none;\r\n    transition: border 0.3s;\r\n}\r\n\r\ninput:focus {\r\n    border-color: #0aa1dd;\r\n}\r\n\r\nbutton {\r\n    width: 100%;\r\n    padding: 10px;\r\n    background-color: #085675;\r\n    border: none;\r\n    color: white;\r\n    font-weight: bold;\r\n    border-radius: 8px;\r\n    cursor: pointer;\r\n    transition: background 0.3s;\r\n}\r\n\r\nbutton:hover {\r\n    background-color: #0a769b;\r\n}\r\n</style>"],"mappings":"AA8DA,eAAe;EACXA,IAAI,EAAE;AACV,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}