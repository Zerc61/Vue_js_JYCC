{"ast":null,"code":"export default {\n  name: \"RegisterPage\",\n  methods: {\n    goRegister() {\n      alert(\"Register ditekan!\");\n    }\n  }\n};","map":{"version":3,"names":["name","methods","goRegister","alert"],"sources":["C:\\xampp\\htdocs\\fahry-project\\src\\pages\\register.vue"],"sourcesContent":["<template>\r\n  <link\r\n    rel=\"stylesheet\"\r\n    href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css\"\r\n  />\r\n\r\n  <div class=\"sing-up-desktop\">\r\n    <div class=\"rectangle\"></div>\r\n\r\n    <div class=\"konten\">\r\n      <img :src=\"require('@/assets/regis.png')\" alt=\"\" class=\"foto\" />\r\n    </div>\r\n    <div class=\"logo\">\r\n      <img :src=\"require('@/assets/scream.png')\" alt=\"\" class=\"foto\" />\r\n    </div>\r\n    <!-- Username -->\r\n    <div class=\"form-usename\">\r\n      <div class=\"div\"></div>\r\n      <i class=\"fa-solid fa-user img\"></i>\r\n      <div class=\"text-wrapper\">Username</div>\r\n    </div>\r\n\r\n    <!-- Email -->\r\n    <div class=\"form-email\">\r\n      <div class=\"div\"></div>\r\n      <i class=\"fa-solid fa-envelope img\"></i>\r\n      <div class=\"text-wrapper-2\">Email</div>\r\n    </div>\r\n\r\n    <!-- Password -->\r\n    <div class=\"form-pw\">\r\n      <div class=\"rectangle-2\"></div>\r\n      <i class=\"fa-solid fa-lock img-2\"></i>\r\n      <div class=\"text-wrapper-3\">Password</div>\r\n    </div>\r\n\r\n    <!-- Konfirmasi / Kode OTP -->\r\n    <div class=\"form-kodeotp\">\r\n      <div class=\"rectangle-2\"></div>\r\n      <i class=\"fa-solid fa-key img-2\"></i>\r\n      <div class=\"text-wrapper-8\">Konfirmasi</div>\r\n    </div>\r\n\r\n    <!-- Tombol Masuk -->\r\n    <div class=\"btn-masuk\" @click=\"goRegister\">\r\n      <div class=\"rectangle-3\"></div>\r\n      <div class=\"text-wrapper-6\">Masuk</div>\r\n    </div>\r\n\r\n    <div class=\"text-wrapper-7\">Sign-in</div>\r\n\r\n    <!-- Sudah punya akun -->\r\n    <div class=\"btn-login\">\r\n      <div class=\"text-wrapper-4\">Sudah punya akun?</div>\r\n      <router-link to=\"/login\" class=\"text-wrapper-5\">Login</router-link>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"RegisterPage\",\r\n\r\n  methods: {\r\n    goRegister() {\r\n      alert(\"Register ditekan!\");\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n/* seluruh CSS tetap sama seperti versi kamu */\r\n.konten {\r\n  position: absolute;\r\n  top: -10%;\r\n  left: 0%;\r\n  text-align: center;\r\n}\r\n\r\n.konten {\r\n  position: absolute;\r\n  top: 30%;\r\n  right: 20%;\r\n  text-align: center;\r\n}\r\n\r\n.sing-up-desktop {\r\n  background: linear-gradient(\r\n      0deg,\r\n      rgba(0, 0, 0, 0.4) 0%,\r\n      rgba(0, 0, 0, 0.4) 100%\r\n    ),\r\n    linear-gradient(0deg, rgba(42, 25, 121, 1) 0%, rgba(42, 25, 121, 1) 100%);\r\n  min-height: 1024px;\r\n  min-width: 1440px;\r\n  position: relative;\r\n  width: 100%;\r\n}\r\n\r\n.sing-up-desktop .rectangle {\r\n  background-color: #ffffff;\r\n  border-radius: 62px;\r\n  box-shadow: inset 0px 9px 4px #00000040;\r\n  height: 960px;\r\n  left: 30px;\r\n  position: absolute;\r\n  top: 26px;\r\n  width: 646px;\r\n}\r\n\r\n.form-usename,\r\n.form-email,\r\n.form-pw,\r\n.form-kodeotp {\r\n  position: absolute;\r\n  height: 53px;\r\n  width: 436px;\r\n}\r\n\r\n.form-email {\r\n  left: 146px;\r\n  top: 263px;\r\n}\r\n\r\n.form-usename {\r\n  left: 145px;\r\n  top: 353px;\r\n}\r\n\r\n.form-pw {\r\n  left: 146px;\r\n  top: 443px;\r\n  width: 434px;\r\n}\r\n\r\n.form-kodeotp {\r\n  left: 146px;\r\n  top: 533px;\r\n  width: 434px;\r\n}\r\n\r\n.div,\r\n.rectangle-2 {\r\n  background-color: #ffffff;\r\n  border: 1px solid #000;\r\n  border-radius: 22px;\r\n  height: 53px;\r\n  width: 434px;\r\n}\r\n\r\n.img,\r\n.img-2 {\r\n  font-size: 22px;\r\n  color: #4d5183;\r\n  position: absolute;\r\n  left: 20px;\r\n  top: 15px;\r\n}\r\n\r\n.img-2 {\r\n  left: 20px;\r\n  top: 13px;\r\n  font-size: 23px;\r\n}\r\n\r\n.text-wrapper,\r\n.text-wrapper-2,\r\n.text-wrapper-3,\r\n.text-wrapper-8 {\r\n  color: #4d5183;\r\n  font-family: \"Inria Sans-Light\", Helvetica;\r\n  font-size: 20px;\r\n  font-weight: 300;\r\n  position: absolute;\r\n  left: 65px;\r\n  top: 14px;\r\n}\r\n\r\n.btn-masuk {\r\n  position: absolute;\r\n  left: 267px;\r\n  top: 616px;\r\n  cursor: pointer;\r\n}\r\n\r\n.rectangle-3 {\r\n  background-color: #4f5999;\r\n  border-radius: 19px;\r\n  height: 53px;\r\n  width: 176px;\r\n}\r\n\r\n.text-wrapper-6 {\r\n  color: white;\r\n  position: absolute;\r\n  top: 15px;\r\n  left: 60px;\r\n  font-weight: bold;\r\n}\r\n\r\n.text-wrapper-7 {\r\n  font-size: 96px;\r\n  color: #3729da;\r\n  position: absolute;\r\n  top: 92px;\r\n  left: 197px;\r\n}\r\n\r\n.btn-login {\r\n  display: flex;\r\n  gap: 10px;\r\n  left: 251px;\r\n  position: absolute;\r\n  top: 699px;\r\n}\r\n\r\n.text-wrapper-4 {\r\n  font-size: 20px;\r\n}\r\n\r\n.text-wrapper-5 {\r\n  color: #0004ff;\r\n  font-size: 20px;\r\n  cursor: pointer;\r\n  text-decoration: underline;\r\n}\r\n</style>\r\n"],"mappings":"AA4DA,eAAe;EACbA,IAAI,EAAE,cAAc;EAEpBC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACXC,KAAK,CAAC,mBAAmB,CAAC;IAC5B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}