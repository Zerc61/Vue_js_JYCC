div>\r\n\r\n  <div class=\"konten\">\r\n    <img src=\"SCREAM DESNITATION (4).png\" alt=\"\" class=\"foto\" />\r\n    <div class=\"button-mulai\">\r\n      <button class=\"mulai\" onclick=\"mulaiLogin()\">Mulai</button>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <div class=\"login\" id=\"loginForm\">\r\n    <h2>Log - in</h2>\r\n    <form action=\"\">\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-envelope\"></i>\r\n        <input type=\"email\" placeholder=\"Email\" />\r\n      </div>\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-lock\"></i>\r\n        <input type=\"password\" placeholder=\"Password\" />\r\n      </div>\r\n      <button type=\"button\">Masuk</button>\r\n      <p>Belum punya akun? <a href=\"#\" onclick=\"mulaiRegister(event)\">Register</a></p>\r\n      <div class=\"social-login\">\r\n        <div class=\"divider\">Atau</div>\r\n        <div class=\"social-icons\">\r\n          <i class=\"fa-brands fa-google\"></i>\r\n          <i class=\"fa-brands fa-twitter\"></i>\r\n          <i class=\"fa-brands fa-facebook\"></i>\r\n        </div>\r\n      </div>\r\n    </form>\r\n  </div>\r\n\r\n  <div class=\"register\" id=\"registerForm\">\r\n    <h2>Register</h2>\r\n    <form action=\"\">\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-user\"></i>\r\n        <input type=\"text\" placeholder=\"Nama Lengkap\" />\r\n      </div>\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-envelope\"></i>\r\n        <input type=\"email\" placeholder=\"Email\" />\r\n      </div>\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-lock\"></i>\r\n        <input type=\"password\" placeholder=\"Password\" />\r\n      </div>\r\n      <div class=\"input-container\">\r\n        <i class=\"fa-solid fa-lock\"></i>\r\n        <input type=\"password\" placeholder=\"Konfirmasi Password\" />\r\n      </div>\r\n      <button type=\"button\">Daftar</button>\r\n      <p>Sudah punya akun? <a href=\"#\" onclick=\"kembaliLogin (event)\">Login</a></p>\r\n    </form>\r\n  </div>\r\n\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    name: \"LoginPage\"\r\n};\r\n\r\nfunction mulaiLogin() {\r\n      const bola = document.querySelector(\".bola\");\r\n      const tombol = document.querySelector(\".mulai\");\r\n      const foto = document.querySelector(\".foto\");\r\n      const login = document.querySelector(\".login\");\r\n\r\n      tombol.classList.add(\"hide-button\");\r\n      bola.classList.add(\"bola-hide-button\");\r\n      foto.classList.add(\"foto-animasi2\");\r\n\r\n      setTimeout(() => {\r\n        login.classList.add(\"show\");\r\n      }, 100);\r\n    }\r\n\r\n    function mulaiRegister(event) {\r\n      event.preventDefault();\r\n      const login = document.getElementById(\"loginForm\");\r\n      const register = document.getElementById(\"registerForm\");\r\n\r\n      login.classList.remove(\"show\");\r\n      login.classList.add(\"hide\");\r\n\r\n      setTimeout(() => {\r\n        register.classList.remove(\"hide\");\r\n        register.classList.add(\"show\");\r\n      }, 400);\r\n    }\r\n\r\n    function kembaliLogin(event) {\r\n      event.preventDefault();\r\n      const login = document.getElementById(\"loginForm\");\r\n      const register = document.getElementById(\"registerForm\");\r\n\r\n      register.classList.remove(\"show\");\r\n      register.classList.add(\"hide\");\r\n\r\n      setTimeout(() => {\r\n        login.classList.remove(\"hide\");\r\n        login.classList.add(\"show\");\r\n      }, 400);\r\n    }\r\n</script>\r\n\r\n<style>\r\n    body {\r\n      margin: 0;\r\n      height: 100vh;\r\n      overflow: hidden;\r\n      background-color: #ffffff;\r\n      font-family: \"Kanit\", sans-serif;\r\n    }\r\n\r\n    .bola {\r\n      width: 30px;\r\n      height: 30px;\r\n      background-color: #083ec8;\r\n      border-radius: 50%;\r\n      position: absolute;\r\n      top: 50%;\r\n      left: 50%;\r\n      transform: translate(-50%, -400px) scale(1);\r\n      animation: bounce 3s ease-in-out forwards;\r\n    } \r\n    \r\n\r\n    @keyframes bounce {\r\n      0% {\r\n        top: -200px;\r\n        transform: translateX(-50%);\r\n      }\r\n      20% {\r\n        top: 50%;\r\n        transform: translateX(-50%) scale(1.1);\r\n      }\r\n      35% {\r\n        transform: translateX(-50%) scale(0.8);\r\n      }\r\n      50% {\r\n        transform: translateX(-50%) scale(1.25);\r\n      }\r\n      65% {\r\n        transform: translateX(-50%) scale(0.95);\r\n      }\r\n      100% {\r\n        top: 50%;\r\n        transform: translate(-50%) scale(40);\r\n      }\r\n    }\r\n\r\n    .bola-hide-button {\r\n      animation: bolaNaik 0.5s ease-in-out forwards;\r\n    }\r\n\r\n    @keyframes bolaNaik {\r\n      0% {\r\n        top: 50%;\r\n        transform: translate(-50%, -50%) scale(40);\r\n      }\r\n      100% {\r\n        top: -66%;\r\n        transform: translate(-50%, -50%) scale(40);\r\n      }\r\n    }\r\n\r\n    .konten {\r\n      position: absolute;\r\n      top: 50%;\r\n      left: 50%;\r\n      transform: translate(-50%, -20%);\r\n      text-align: center;\r\n      opacity: 0;\r\n      animation: tampilKonten 6s ease-in-out forwards;\r\n    }\r\n\r\n    @keyframes tampilKonten {\r\n      0% { opacity: 0; }\r\n      20% { opacity: 1; }\r\n      100% { opacity: 1; }\r\n    }\r\n\r\n    .foto {\r\n      width: 300px;\r\n      height: 300px;\r\n      object-fit: cover;\r\n      opacity: 0;\r\n      z-index: 2;\r\n      animation: animFoto 2s ease-in-out forwards;\r\n      animation-delay: 1.87s;\r\n    }\r\n\r\n    @keyframes animFoto {\r\n      0%, 10% {\r\n        opacity: 0;\r\n        transform: translateY(0) scale(1);\r\n      }\r\n      30%, 70% {\r\n        opacity: 1;\r\n        transform: translateY(0) scale(1);\r\n      }\r\n      100% {\r\n        opacity: 1;\r\n        transform: translateY(-95px) scale(0.73);\r\n      }\r\n    }\r\n\r\n    .foto-animasi2 {\r\n      animation: fotoNaik 0.5s ease-in-out forwards;\r\n    }\r\n\r\n    @keyframes fotoNaik {\r\n      0% {\r\n        opacity: 1;\r\n        transform: translateY(-95px) scale(0.73);\r\n      }\r\n      100% {\r\n        opacity: 1;\r\n        transform: translateY(-230px) scale(0.49);\r\n      }\r\n    }\r\n\r\n    .button-mulai {\r\n      position: relative;\r\n      top: 60px;\r\n    }\r\n\r\n    .mulai {\r\n      padding: 8px 25px;\r\n      font-size: 16px;\r\n      font-weight: 500;\r\n      border: 1.5px solid #3367d6;\r\n      border-radius: 8px;\r\n      background-color: #6581dd;\r\n      color: #ffffff;\r\n      cursor: pointer;\r\n      transition: all 0.3s ease;\r\n      opacity: 0;\r\n      transform: translateY(100px);\r\n      animation: tampilTombol 1s ease-in-out forwards;\r\n      animation-delay: 3s;\r\n    }\r\n\r\n    @keyframes tampilTombol {\r\n      0% {\r\n        opacity: 0;\r\n        transform: translateY(100px);\r\n      }\r\n      100% {\r\n        opacity: 1;\r\n        transform: translateY(0);\r\n      }\r\n    }\r\n\r\n    .mulai:hover {\r\n      background-color: #3367d6;\r\n    }\r\n\r\n    .hide-button {\r\n      opacity: 0;\r\n      display: none;\r\n    }\r\n\r\n    /* ========================= LOGIN ========================= */\r\n    .login {\r\n      position: absolute;\r\n      top: 110%;\r\n      left: 50%;\r\n      transform: translate(-50%, 0);\r\n      text-align: center;\r\n      width: 100%;\r\n      opacity: 0;\r\n      z-index: 2;\r\n      transition: all 0.8s ease-in-out;\r\n    }\r\n\r\n    .login.show {\r\n      top: 55%;\r\n      transform: translate(-50%, -50%);\r\n      opacity: 1;\r\n    }\r\n\r\n    .login.hide {\r\n      opacity: 0;\r\n      transform: translate(-50%, 50%);\r\n      pointer-events: none;\r\n    }\r\n\r\n    .login h2 {\r\n      margin: 29px 0;\r\n      font-weight: 500;\r\n      font-size: 36px;\r\n      color: #1a2dbf;\r\n    }\r\n\r\n    .login .input-container {\r\n      position: relative;\r\n      width: 300px;\r\n      margin: 10px auto;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n    }\r\n\r\n    .login .input-container i {\r\n      position: absolute;\r\n      top: 50%;\r\n      left: 50px;\r\n      transform: translateY(-50%);\r\n      color: #1a2dbf;\r\n      font-size: 16px;\r\n    }\r\n\r\n    .login .input-container input {\r\n      width: 80%;\r\n      padding: 14px 16px 14px 45px;\r\n      border-radius: 8px;\r\n      border: 1px solid #000000;\r\n      outline: none;\r\n      font-size: 15px;\r\n      box-sizing: border-box;\r\n    }\r\n\r\n    .login button {\r\n      width: 110px;\r\n      padding: 10px;\r\n      background-color: #2b4ae4;\r\n      border: none;\r\n      color: #ffffff;\r\n      border-radius: 8px;\r\n      cursor: pointer;\r\n      margin-top: 10px;\r\n      font-weight: bold;\r\n      transition: all 0.3s ease;\r\n    }\r\n\r\n    .login button:hover {\r\n      background-color: #2039b8;\r\n    }\r\n\r\n    .login p {\r\n      margin-top: 10px;\r\n      font-size: 14px;\r\n    }\r\n\r\n    .login a {\r\n      color: #1a2dbf;\r\n      text-decoration: none;\r\n      font-weight: 500;\r\n    }\r\n\r\n    .login a:hover {\r\n      text-decoration: underline;\r\n    }\r\n\r\n    /* ========================= REGISTER ========================= */\r\n    .register {\r\n      position: absolute;\r\n      top: 120%;\r\n      left: 50%;\r\n      transform: translate(-50%, 0);\r\n      text-align: center;\r\n      width: 100%;\r\n      opacity: 0;\r\n      z-index: 1;\r\n      transition: all 0.8s ease-in-out;\r\n    }\r\n\r\n    .register.show {\r\n      top: 60%;\r\n      transform: translate(-50%, -50%);\r\n      opacity: 1;\r\n      z-index: 3;\r\n    }\r\n\r\n    .register.hide {\r\n      opacity: 0;\r\n      transform: translate(-50%, 50%);\r\n      pointer-events: none;\r\n    }\r\n\r\n    .register h2 {\r\n      margin: 29px 0;\r\n      font-weight: 500;\r\n      font-size: 36px;\r\n      color: #1a2dbf;\r\n    }\r\n\r\n    .register .input-container {\r\n      position: relative;\r\n      width: 300px;\r\n      margin: 10px auto;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n    }\r\n\r\n    .register .input-container i {\r\n      position: absolute;\r\n      top: 50%;\r\n      left: 50px;\r\n      transform: translateY(-50%);\r\n      color: #1a2dbf;\r\n      font-size: 16px;\r\n    }\r\n\r\n    .register .input-container input {\r\n      width: 80%;\r\n      padding: 14px 16px 14px 45px;\r\n      border-radius: 8px;\r\n      border: 1px solid #000000;\r\n      outline: none;\r\n      font-size: 15px;\r\n      box-sizing: border-box;\r\n    }\r\n\r\n    .register button {\r\n      width: 110px;\r\n      padding: 10px;\r\n      background-color: #2b4ae4;\r\n      border: none;\r\n      color: #ffffff;\r\n      border-radius: 8px;\r\n      cursor: pointer;\r\n      margin-top: 10px;\r\n      font-weight: bold;\r\n      transition: all 0.3s ease;\r\n    }\r\n\r\n    .register button:hover {\r\n      background-color: #2039b8;\r\n    }\r\n\r\n    .register p {\r\n      margin-top: 10px;\r\n      font-size: 14px;\r\n    }\r\n\r\n    .register a {\r\n      color: #1a2dbf;\r\n      text-decoration: none;\r\n      font-weight: 500;\r\n    }\r\n\r\n    .register a:hover {\r\n      text-decoration: underline;\r\n    }\r\n\r\n      .social-login {\r\n      margin-top: 20px;\r\n    }\r\n\r\n    .social-login .divider {\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      color: gray;\r\n      font-size: 14px;\r\n      margin: 15px 0;\r\n    }\r\n\r\n    .social-login .divider::before,\r\n    .social-login .divider::after {\r\n      content: \"\";\r\n      height: 1px;\r\n      width: 80px;\r\n      background: #ccc;\r\n      margin: 0 10px;\r\n    }\r\n\r\n    .social-icons {\r\n      display: flex;\r\n      justify-content: center;\r\n      gap: 20px;\r\n      margin-top: 10px;\r\n    }\r\n\r\n    .social-icons i {\r\n      font-size: 28px;\r\n      cursor: pointer;\r\n      transition: 0.3s;\r\n    }\r\n\r\n    .social-icons .fa-google { color: #db4437; }\r\n    .social-icons .fa-twitter { color: #1da1f2; }\r\n    .social-icons .fa-facebook { color: #1877f2; }\r\n\r\n    .social-icons i:hover { transform: scale(1.2); }\r\n</style>"],"mappings":";;uFAEEA,mBAAA,CAAwB;IAAnBC,KAAK,EAAC;EAAM,4B,0BAEjBD,mBAAA,CAMM;IANDC,KAAK,EAAC;EAAQ,IACjBD,mBAAA,CAA4D;IAAvDE,GAAG,EAAC,4BAA4B;IAACC,GAAG,EAAC,EAAE;IAACF,KAAK,EAAC;MACnDD,mBAAA,CAEM;IAFDC,KAAK,EAAC;EAAc,IACvBD,mBAAA,CAA2D;IAAnDC,KAAK,EAAC,OAAO;IAACG,OAAO,EAAC;KAAe,OAAK,E,iDAKtDJ,mBAAA,CAsBM;IAtBDC,KAAK,EAAC,OAAO;IAACI,EAAE,EAAC;MACpBL,mBAAA,CAAiB,YAAb,UAAQ,GACZA,mBAAA,CAmBO;IAnBDM,MAAM,EAAC;EAAE,IACbN,mBAAA,CAGM;IAHDC,KAAK,EAAC;EAAiB,IAC1BD,mBAAA,CAAoC;IAAjCC,KAAK,EAAC;EAAsB,IAC/BD,mBAAA,CAA0C;IAAnCO,IAAI,EAAC,OAAO;IAACC,WAAW,EAAC;QAElCR,mBAAA,CAGM;IAHDC,KAAK,EAAC;EAAiB,IAC1BD,mBAAA,CAAgC;IAA7BC,KAAK,EAAC;EAAkB,IAC3BD,mBAAA,CAAgD;IAAzCO,IAAI,EAAC,UAAU;IAACC,WAAW,EAAC;QAErCR,mBAAA,CAAoC;IAA5BO,IAAI,EAAC;EAAQ,GAAC,OAAK,GAC3BP,mBAAA,CAAgF,Y,iBAA7E,oBAAkB,GAAAA,mBAAA,CAAuD;IAApDS,IAAI,EAAC,GAAG;IAACL,OAAO,EAAC;KAAuB,UAAQ,E,GACxEJ,mBAAA,CAOM;IAPDC,KAAK,EAAC;EAAc,IACvBD,mBAAA,CAA+B;IAA1BC,KAAK,EAAC;EAAS,GAAC,MAAI,GACzBD,mBAAA,CAIM;IAJDC,KAAK,EAAC;EAAc,IACvBD,mBAAA,CAAmC;IAAhCC,KAAK,EAAC;EAAqB,IAC9BD,mBAAA,CAAoC;IAAjCC,KAAK,EAAC;EAAsB,IAC/BD,mBAAA,CAAqC;IAAlCC,KAAK,EAAC;EAAuB,G,qDAMxCD,mBAAA,CAsBM;IAtBDC,KAAK,EAAC,UAAU;IAACI,EAAE,EAAC;MACvBL,mBAAA,CAAiB,YAAb,UAAQ,GACZA,mBAAA,CAmBO;IAnBDM,MAAM,EAAC;EAAE,IACbN,mBAAA,CAGM;IAHDC,KAAK,EAAC;EAAiB,IAC1BD,mBAAA,CAAgC;IAA7BC,KAAK,EAAC;EAAkB,IAC3BD,mBAAA,CAAgD;IAAzCO,IAAI,EAAC,MAAM;IAACC,WAAW,EAAC;QAEjCR,mBAAA,CAGM;IAHDC,KAAK,EAAC;EAAiB,IAC1BD,mBAAA,CAAoC;IAAjCC,KAAK,EAAC;EAAsB,IAC/BD,mBAAA,CAA0C;IAAnCO,IAAI,EAAC,OAAO;IAACC,WAAW,EAAC;QAElCR,mBAAA,CAGM;IAHDC,KAAK,EAAC;EAAiB,IAC1BD,mBAAA,CAAgC;IAA7BC,KAAK,EAAC;EAAkB,