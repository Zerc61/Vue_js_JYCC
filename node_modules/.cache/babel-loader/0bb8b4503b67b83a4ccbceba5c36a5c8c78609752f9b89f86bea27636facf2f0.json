olid fa-face-grin-squint-tears scream-icon\"></i>\r\n\r\n    </div>\r\n\r\n    <!-- Form -->\r\n    <div class=\"form-section\">\r\n      <div class=\"form-card\">\r\n\r\n        <h1 class=\"login-title\">Login</h1>\r\n\r\n        <!-- Email -->\r\n        <div class=\"form-group\">\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-envelope icon\"></i>\r\n            <input type=\"email\" placeholder=\"Email\" class=\"input-field\" />\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Password -->\r\n        <div class=\"form-group\">\r\n          <div class=\"input-container\">\r\n            <i class=\"fa-solid fa-lock icon\"></i>\r\n            <input type=\"password\" placeholder=\"Password\" class=\"input-field\" />\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Button -->\r\n        <button class=\"login-btn\">Masuk</button>\r\n\r\n        <!-- Sign up -->\r\n        <div class=\"signup-link\">\r\n          <span>Belum punya akun? </span>\r\n          <a href=\"#\" class=\"signup-text\">Sign-in</a>\r\n        </div>\r\n\r\n        <!-- Divider -->\r\n        <div class=\"divider\">\r\n          <span class=\"line\"></span>\r\n          <span class=\"or-text\">Atau</span>\r\n          <span class=\"line\"></span>\r\n        </div>\r\n\r\n        <!-- Social Login -->\r\n        <div class=\"social-login\">\r\n          <i class=\"fa-brands fa-facebook fa-3x social-icon facebook\"></i>\r\n          <i class=\"fa-brands fa-twitter fa-3x social-icon twitter\"></i>\r\n          <i class=\"fa-brands fa-google fa-3x social-icon google\"></i>\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n</template>\r\n\r\n\r\n<script>\r\nexport default {\r\n  name: \"LoginPages\",\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Reset dasar */\r\n* {\r\n  box-sizing: border-box;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.konten {\r\n  position: absolute;\r\n  top: -10%;\r\n  left: 0%;\r\n  text-align: center;\r\n}\r\n/* Container utama */\r\n.login-web {\r\n  display: flex;\r\n  flex-direction: row; /* Horizontal pada desktop */\r\n  min-height: 100vh;\r\n  background: linear-gradient(\r\n    0deg,\r\n    rgba(0, 0, 0, 0.4) 0%,\r\n    rgba(0, 0, 0, 0.4) 100%\r\n  ), linear-gradient(0deg, rgba(42, 25, 121, 1) 0%, rgba(42, 25, 121, 1) 100%);\r\n  font-family: \"Inria Sans\", Helvetica, sans-serif;\r\n}\r\n\r\n/* Bagian Background */\r\n.background-section {\r\n  flex: 1;\r\n  position: relative;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 20px;\r\n}\r\n\r\n.travel-by-plane {\r\n  width: 100%;\r\n  max-width: 600px;\r\n  height: auto;\r\n  object-fit: cover;\r\n}\r\n\r\n.welcome-text {\r\n  position: absolute;\r\n  bottom: 20%;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  color: #ffffff;\r\n  font-family: \"Baloo Thambi-Regular\", Helvetica;\r\n  font-size: 2.5rem;\r\n  font-weight: 400;\r\n  text-align: center;\r\n}\r\n\r\n.scream {\r\n  position: absolute;\r\n  top: 10%;\r\n  left: 10%;\r\n  width: 20%;\r\n  max-width: 200px;\r\n  height: auto;\r\n}\r\n\r\n/* Bagian Form */\r\n.form-section {\r\n  flex: 1;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 20px;\r\n}\r\n\r\n.form-card {\r\n  background-color: #ffffff;\r\n  border-radius: 62px;\r\n  box-shadow: 0px 9px 4px rgba(0, 0, 0, 0.4);\r\n  padding: 40px;\r\n  width: 100%;\r\n  max-width: 500px;\r\n  text-align: center;\r\n}\r\n\r\n.login-title {\r\n  color: #3729da;\r\n  font-family: \"Kanit-Medium\", Helvetica;\r\n  font-size: 3rem;\r\n  font-weight: 500;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n/* Input */\r\n.form-group {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.input-container {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.icon {\r\n  position: absolute;\r\n  left: 15px;\r\n  width: 24px;\r\n  height: 24px;\r\n}\r\n\r\n.input-field {\r\n  width: 100%;\r\n  padding: 15px 15px 15px 50px;\r\n  border: 1px solid #000000;\r\n  border-radius: 22px;\r\n  font-size: 1rem;\r\n  color: #4d5183;\r\n  background-color: #ffffff;\r\n}\r\n\r\n/* Tombol */\r\n.login-btn {\r\n  background-color: #4f5999;\r\n  color: #ffffff;\r\n  border: none;\r\n  border-radius: 19px;\r\n  padding: 15px 30px;\r\n  font-size: 1.2rem;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  margin: 20px 0;\r\n}\r\n\r\n.signup-link {\r\n  margin-top: 20px;\r\n  font-size: 1rem;\r\n}\r\n\r\n.signup-text {\r\n  color: #0004ff;\r\n  text-decoration: none;\r\n}\r\n\r\n/* Divider */\r\n.divider {\r\n  display: flex;\r\n  align-items: center;\r\n  margin: 30px 0;\r\n}\r\n\r\n.vector {\r\n  flex: 1;\r\n  height: 1px;\r\n  object-fit: cover;\r\n}\r\n\r\n.or-text {\r\n  margin: 160px;\r\n  color: #000000;\r\n  font-size: 1rem;\r\n}\r\n\r\n/* Sosial */\r\n.social-login {\r\n  display: flex;\r\n  justify-content: space-around;\r\n  margin-top: 20px;\r\n}\r\n\r\n.social-icon {\r\n  width: 60px;\r\n  height: 60px;\r\n  cursor: pointer;\r\n}\r\n\r\n/* Responsif */\r\n@media (max-width: 768px) {\r\n  .login-web {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .background-section {\r\n    height: 50vh;\r\n  }\r\n\r\n  .welcome-text {\r\n    font-size: 2rem;\r\n    bottom: 10%;\r\n  }\r\n\r\n  .scream {\r\n    top: 5%;\r\n    left: 5%;\r\n    width: 15%;\r\n  }\r\n\r\n  .form-card {\r\n    padding: 20px;\r\n    border-radius: 30px;\r\n  }\r\n\r\n  .login-title {\r\n    font-size: 2.5rem;\r\n  }\r\n\r\n  .social-login {\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n  }\r\n\r\n  .social-icon {\r\n    width: 50px;\r\n    height: 50px;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .welcome-text {\r\n    font-size: 1.5rem;\r\n  }\r\n\r\n  .login-title {\r\n    font-size: 2rem;\r\n  }\r\n\r\n  .input-field {\r\n    padding: 12px 12px 12px 40px;\r\n  }\r\n\r\n  .icon {\r\n    width: 20px;\r\n    height: 20px;\r\n    left: 10px;\r\n  }\r\n\r\n  .login-btn {\r\n    padding: 12px 20px;\r\n    font-size: 1rem;\r\n  }\r\n\r\n  .social-icon {\r\n    width: 40px;\r\n    height: 40px;\r\n  }\r\n}\r\n</style>"],"mappings":";;EAEOA,KAAK,EAAC;AAAW;;EAEfA,KAAK,EAAC;AAAQ;;;uFAHrBC,mBAAA,CAAyG;IAAnGC,GAAG,EAAC,YAAY;IAACC,IAAI,EAAC;8BAC5BF,mBAAA,CAkEM,OAlENG,UAkEM,GAhEJH,mBAAA,CAEM,OAFNI,UAEM,GADJJ,mBAAA,CAAiE;IAA3DK,GAAG,EAAEC,OAAO;IAAyBC,GAAG,EAAC,EAAE;IAACR,KAAK,EAAC;yCAE1DS,mBAAA,gBAAmB,E,0BACnBR,mBAAA,CAUM;IAVDD,KAAK,EAAC;EAAoB,IAE7BS,mBAAA,UAAa,EACbR,mBAAA,CAA4D;IAAzDD,KAAK,EAAC;EAA8C,IAEvDC,mBAAA,CAAmD;IAA9CD,KAAK,EAAC;EAAc,GAAC,qBAAmB,GAE7CS,mBAAA,0CAA6C,EAC7CR,mBAAA,CAA8D;IAA3DD,KAAK,EAAC;EAAgD,G,qBAI3DS,mBAAA,UAAa,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}