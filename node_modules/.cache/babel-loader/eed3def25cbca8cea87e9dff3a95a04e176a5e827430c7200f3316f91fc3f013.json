\r\n    <div class=\"bola\"></div>\r\n\r\n    <div class=\"konten\">\r\n      <img src=\"\" alt=\"\" class=\"foto\" />\r\n      <div class=\"button-mulai\">\r\n        <button class=\"mulai\" @click=\"mulaiLogin\">Mulai</button>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"login\" id=\"loginForm\">\r\n      <h2>Log - in</h2>\r\n      <form action=\"\">\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-envelope\"></i>\r\n          <input type=\"email\" placeholder=\"Email\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-lock\"></i>\r\n          <input type=\"password\" placeholder=\"Password\" />\r\n        </div>\r\n        <button type=\"button\">Masuk</button>\r\n        <p>Belum punya akun? <a href=\"#\" @click.prevent=\"mulaiRegister\">Register</a></p>\r\n        <div class=\"social-login\">\r\n          <div class=\"divider\">Atau</div>\r\n          <div class=\"social-icons\">\r\n            <i class=\"fa-brands fa-google\"></i>\r\n            <i class=\"fa-brands fa-twitter\"></i>\r\n            <i class=\"fa-brands fa-facebook\"></i>\r\n          </div>\r\n        </div>\r\n      </form>\r\n    </div>\r\n\r\n    <div class=\"register\" id=\"registerForm\">\r\n      <h2>Register</h2>\r\n      <form action=\"\">\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-user\"></i>\r\n          <input type=\"text\" placeholder=\"Nama Lengkap\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-envelope\"></i>\r\n          <input type=\"email\" placeholder=\"Email\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-lock\"></i>\r\n          <input type=\"password\" placeholder=\"Password\" />\r\n        </div>\r\n        <div class=\"input-container\">\r\n          <i class=\"fa-solid fa-lock\"></i>\r\n          <input type=\"password\" placeholder=\"Konfirmasi Password\" />\r\n        </div>\r\n        <button type=\"button\">Daftar</button>\r\n        <p>Sudah punya akun? <a href=\"#\" @click.prevent=\"kembaliLogin\">Login</a></p>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"LoginPage\",\r\n  methods: {\r\n    mulaiLogin() {\r\n      const bola = document.querySelector(\".bola\");\r\n      const tombol = document.querySelector(\".mulai\");\r\n      const foto = document.querySelector(\".foto\");\r\n      const login = document.querySelector(\".login\");\r\n\r\n      tombol.classList.add(\"hide-button\");\r\n      bola.classList.add(\"bola-hide-button\");\r\n      foto.classList.add(\"foto-animasi2\");\r\n\r\n      setTimeout(() => {\r\n        login.classList.add(\"show\");\r\n      }, 100);\r\n    },\r\n\r\n    mulaiRegister(event) {\r\n      event.preventDefault();\r\n      const login = document.getElementById(\"loginForm\");\r\n      const register = document.getElementById(\"registerForm\");\r\n\r\n      login.classList.remove(\"show\");\r\n      login.classList.add(\"hide\");\r\n\r\n      setTimeout(() => {\r\n        register.classList.remove(\"hide\");\r\n        register.classList.add(\"show\");\r\n      }, 400);\r\n    },\r\n\r\n    kembaliLogin(event) {\r\n      event.preventDefault();\r\n      const login = document.getElementById(\"loginForm\");\r\n      const register = document.getElementById(\"registerForm\");\r\n\r\n      register.classList.remove(\"show\");\r\n      register.classList.add(\"hide\");\r\n\r\n      setTimeout(() => {\r\n        login.classList.remove(\"hide\");\r\n        login.classList.add(\"show\");\r\n      }, 400);\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style>\r\nbody {\r\n  margin: 0;\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  background-color: #ffffff;\r\n  font-family: \"Kanit\", sans-serif;\r\n}\r\n\r\n.bola {\r\n  width: 30px;\r\n  height: 30px;\r\n  background-color: #083ec8;\r\n  border-radius: 50%;\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -400px) scale(1);\r\n  animation: bounce 3s ease-in-out forwards;\r\n}\r\n\r\n@keyframes bounce {\r\n  0% {\r\n    top: -200px;\r\n    transform: translateX(-50%);\r\n  }\r\n  20% {\r\n    top: 50%;\r\n    transform: translateX(-50%) scale(1.1);\r\n  }\r\n  35% {\r\n    transform: translateX(-50%) scale(0.8);\r\n  }\r\n  50% {\r\n    transform: translateX(-50%) scale(1.25);\r\n  }\r\n  65% {\r\n    transform: translateX(-50%) scale(0.95);\r\n  }\r\n  100% {\r\n    top: 50%;\r\n    transform: translate(-50%) scale(40);\r\n  }\r\n}\r\n\r\n.bola-hide-button {\r\n  animation: bolaNaik 0.5s ease-in-out forwards;\r\n}\r\n\r\n@keyframes bolaNaik {\r\n  0% {\r\n    top: 50%;\r\n    transform: translate(-50%, -50%) scale(40);\r\n  }\r\n  100% {\r\n    top: -66%;\r\n    transform: translate(-50%, -50%) scale(40);\r\n  }\r\n}\r\n\r\n.konten {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%);\r\n  text-align: center;\r\n  opacity: 0;\r\n  animation: tampilKonten 6s ease-in-out forwards;\r\n}\r\n\r\n@keyframes tampilKonten {\r\n  0% { opacity: 0; }\r\n  20% { opacity: 1; }\r\n  100% { opacity: 1; }\r\n}\r\n\r\n.foto {\r\n  width: 300px;\r\n  height: 300px;\r\n  object-fit: cover;\r\n  opacity: 0;\r\n  z-index: 2;\r\n  animation: animFoto 2s ease-in-out forwards;\r\n  animation-delay: 1.87s;\r\n}\r\n\r\n@keyframes animFoto {\r\n  0%, 10% {\r\n    opacity: 0;\r\n    transform: translateY(0) scale(1);\r\n  }\r\n  30%, 70% {\r\n    opacity: 1;\r\n    transform: translateY(0) scale(1);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    transform: translateY(-95px) scale(0.73);\r\n  }\r\n}\r\n\r\n.foto-animasi2 {\r\n  animation: fotoNaik 0.5s ease-in-out forwards;\r\n}\r\n\r\n@keyframes fotoNaik {\r\n  0% {\r\n    opacity: 1;\r\n    transform: translateY(-95px) scale(0.73);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    transform: translateY(-230px) scale(0.49);\r\n  }\r\n}\r\n\r\n.button-mulai {\r\n  position: relative;\r\n  top: 60px;\r\n}\r\n\r\n.mulai {\r\n  padding: 8px 25px;\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  border: 1.5px solid #3367d6;\r\n  border-radius: 8px;\r\n  background-color: #6581dd;\r\n  color: #ffffff;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  opacity: 0;\r\n  transform: translateY(100px);\r\n  animation: tampilTombol 1s ease-in-out forwards;\r\n  animation-delay: 3s;\r\n}\r\n\r\n@keyframes tampilTombol {\r\n  0% {\r\n    opacity: 0;\r\n    transform: translateY(100px);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n.mulai:hover {\r\n  background-color: #3367d6;\r\n}\r\n\r\n.hide-button {\r\n  opacity: 0;\r\n  display: none;\r\n}\r\n\r\n/* ========================= LOGIN ========================= */\r\n.login {\r\n  position: absolute;\r\n  top: 110%;\r\n  left: 50%;\r\n  transform: translate(-50%, 0);\r\n  text-align: center;\r\n  width: 100%;\r\n  opacity: 0;\r\n  z-index: 2;\r\n  transition: all 0.8s ease-in-out;\r\n}\r\n\r\n.login.show {\r\n  top: 55%;\r\n  transform: translate(-50%, -50%);\r\n  opacity: 1;\r\n}\r\n\r\n.login.hide {\r\n  opacity: 0;\r\n  transform: translate(-50%, 50%);\r\n  pointer-events: none;\r\n}\r\n\r\n.login h2 {\r\n  margin: 29px 0;\r\n  font-weight: 500;\r\n  font-size: 36px;\r\n  color: #1a2dbf;\r\n}\r\n\r\n.login .input-container {\r\n  position: relative;\r\n  width: 300px;\r\n  margin: 10px auto;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.login .input-container i {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50px;\r\n  transform: translateY(-50%);\r\n  color: #1a2dbf;\r\n  font-size: 16px;\r\n}\r\n\r\n.login .input-container input {\r\n  width: 80%;\r\n  padding: 14px 16px 14px 45px;\r\n  border-radius: 8px;\r\n  border: 1px solid #000000;\r\n  outline: none;\r\n  font-size: 15px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.login button {\r\n  width: 110px;\r\n  padding: 10px;\r\n  background-color: #2b4ae4;\r\n  border: none;\r\n  color: #ffffff;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  margin-top: 10px;\r\n  font-weight: bold;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.login button:hover {\r\n  background-color: #2039b8;\r\n}\r\n\r\n.login p {\r\n  margin-top: 10px;\r\n  font-size: 14px;\r\n}\r\n\r\n.login a {\r\n  color: #1a2dbf;\r\n  text-decoration: none;\r\n  font-weight: 500;\r\n}\r\n\r\n.login a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n/* ========================= REGISTER ========================= */\r\n.register {\r\n  position: absolute;\r\n  top: 120%;\r\n  left: 50%;\r\n  transform: translate(-50%, 0);\r\n  text-align: center;\r\n  width: 100%;\r\n  opacity: 0;\r\n  z-index: 1;\r\n  transition: all 0.8s ease-in-out;\r\n}\r\n\r\n.register.show {\r\n  top: 60%;\r\n  transform: translate(-50%, -50%);\r\n  opacity: 1;\r\n  z-index: 3;\r\n}\r\n\r\n.register.hide {\r\n  opacity: 0;\r\n  transform: translate(-50%, 50%);\r\n  pointer-events: none;\r\n}\r\n\r\n.register h2 {\r\n  margin: 29px 0;\r\n  font-weight: 500;\r\n  font-size: 36px;\r\n  color: #1a2dbf;\r\n}\r\n\r\n.register .input-container {\r\n  position: relative;\r\n  width: 300px;\r\n  margin: 10px auto;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.register .input-container i {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50px;\r\n  transform: translateY(-50%);\r\n  color: #1a2dbf;\r\n  font-size: 16px;\r\n}\r\n\r\n.register .input-container input {\r\n  width: 80%;\r\n  padding: 14px 16px 14px 45px;\r\n  border-radius: 8px;\r\n  border: 1px solid #000000;\r\n  outline: none;\r\n  font-size: 15px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.register button {\r\n  width: 110px;\r\n  padding: 10px;\r\n  background-color: #2b4ae4;\r\n  border: none;\r\n  color: #ffffff;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  margin-top: 10px;\r\n  font-weight: bold;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.register button:hover {\r\n  background-color: #2039b8;\r\n}\r\n\r\n.register p {\r\n  margin-top: 10px;\r\n  font-size: 14px;\r\n}\r\n\r\n.register a {\r\n  color: #1a2dbf;\r\n  text-decoration: none;\r\n  font-weight: 500;\r\n}\r\n\r\n.register a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.social-login {\r\n  margin-top: 20px;\r\n}\r\n\r\n.social-login .divider {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: gray;\r\n  font-size: 14px;\r\n  margin: 15px 0;\r\n}\r\n\r\n.social-login .divider::before,\r\n.social-login .divider::after {\r\n  content: \"\";\r\n  height: 1px;\r\n  width: 80px;\r\n  background: #ccc;\r\n  margin: 0 10px;\r\n}\r\n\r\n.social-icons {\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 20px;\r\n  margin-top: 10px;\r\n}\r\n\r\n.social-icons i {\r\n  font-size: 28px;\r\n  cursor: pointer;\r\n  transition: 0.3s;\r\n}\r\n\r\n.social-icons .fa-google { color: #db4437; }\r\n.social-icons .fa-twitter { color: #1da1f2; }\r\n.social-icons .fa-facebook { color: #1877f2; }\r\n\r\n.social-icons i:hover { transform: scale(1.2); }\r\n\r\n</style>"],"mappings":";;EAISA,KAAK,EAAC;AAAQ;;EAEZA,KAAK,EAAC;AAAc;;EAKtBA,KAAK,EAAC,OAAO;EAACC,EAAE,EAAC;;;EAEdC,MAAM,EAAC;AAAE;;EAsBZF,KAAK,EAAC,UAAU;EAACC,EAAE,EAAC;;;EAEjBC,MAAM,EAAC;AAAE;;uBApCnBC,mBAAA,CAyDM,c,4BAxDJC,mBAAA,CAAwB;IAAnBJ,KAAK,EAAC;EAAM,4BAEjBI,mBAAA,CAKM,OALNC,UAKM,G,0BAJJD,mBAAA,CAAkC;IAA7BE,GAAG,EAAC,EAAE;IAACC,GAAG,EAAC,EAAE;IAACP,KAAK,EAAC;8BACzBI,mBAAA,CAEM,OAFNI,UAEM,GADJJ,mBAAA,CAAwD;IAAhDJ,KAAK,EAAC,OAAO;IAAES,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,QAAA,CAAAC,UAAA,IAAAD,QAAA,CAAAC,UAAA,IAAAF,IAAA,CAAU;KAAE,OAAK,E,KAInDP,mBAAA,CAsBM,OAtBNU,UAsBM,G,0BArBJV,mBAAA,CAAiB,YAAb,UAAQ,qBACZA,mBAAA,CAmBO,QAnBPW,UAmBO,G,4UATLX,mBAAA,CAAgF,Y,2CAA7E,oBAAkB,qBAAAA,mBAAA,CAAuD;IAApDY,IAAI,EAAC,GAAG;IAAEP,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAO,cAAA,KAAAN,IAAA,KAAUC,QAAA,CAAAM,aAAA,IAAAN,QAAA,CAAAM,aAAA,IAAAP,IAAA,CA