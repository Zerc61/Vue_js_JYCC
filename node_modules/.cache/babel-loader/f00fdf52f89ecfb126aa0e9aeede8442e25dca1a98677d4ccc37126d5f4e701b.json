font-size: 1rem;\r\n  color: #4d5183;\r\n  background-color: #ffffff;\r\n}\r\n\r\n/* Tombol */\r\n.login-btn {\r\n  background-color: #4f5999;\r\n  color: #ffffff;\r\n  border: none;\r\n  border-radius: 19px;\r\n  padding: 15px 30px;\r\n  font-size: 1.2rem;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  margin: 20px 0;\r\n}\r\n\r\n.signup-link {\r\n  margin-top: 20px;\r\n  font-size: 1rem;\r\n}\r\n\r\n.signup-text {\r\n  color: #0004ff;\r\n  text-decoration: none;\r\n}\r\n\r\n/* Divider */\r\n.divider {\r\n  display: flex;\r\n  align-items: center;\r\n  margin: 30px 0;\r\n}\r\n\r\n.vector {\r\n  flex: 1;\r\n  height: 1px;\r\n  object-fit: cover;\r\n}\r\n\r\n.or-text {\r\n  margin: 0 10px;\r\n  color: #000000;\r\n  font-size: 1rem;\r\n}\r\n\r\n/* Sosial */\r\n.social-login {\r\n  display: flex;\r\n  justify-content: space-around;\r\n  margin-top: 20px;\r\n}\r\n\r\n.social-icon {\r\n  width: 60px;\r\n  height: 60px;\r\n  cursor: pointer;\r\n}\r\n\r\n/* Responsif */\r\n@media (max-width: 768px) {\r\n  .login-web {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .background-section {\r\n    height: 50vh;\r\n  }\r\n\r\n  .welcome-text {\r\n    font-size: 2rem;\r\n    bottom: 10%;\r\n  }\r\n\r\n  .scream {\r\n    top: 5%;\r\n    left: 5%;\r\n    width: 15%;\r\n  }\r\n\r\n  .form-card {\r\n    padding: 20px;\r\n    border-radius: 30px;\r\n  }\r\n\r\n  .login-title {\r\n    font-size: 2.5rem;\r\n  }\r\n\r\n  .social-login {\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n  }\r\n\r\n  .social-icon {\r\n    width: 50px;\r\n    height: 50px;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .welcome-text {\r\n    font-size: 1.5rem;\r\n  }\r\n\r\n  .login-title {\r\n    font-size: 2rem;\r\n  }\r\n\r\n  .input-field {\r\n    padding: 12px 12px 12px 40px;\r\n  }\r\n\r\n  .icon {\r\n    width: 20px;\r\n    height: 20px;\r\n    left: 10px;\r\n  }\r\n\r\n  .login-btn {\r\n    padding: 12px 20px;\r\n    font-size: 1rem;\r\n  }\r\n\r\n  .social-icon {\r\n    width: 40px;\r\n    heigh