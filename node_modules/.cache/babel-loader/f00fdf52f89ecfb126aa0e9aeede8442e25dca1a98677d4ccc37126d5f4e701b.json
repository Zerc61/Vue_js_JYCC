m-card\">\r\n        <h1 class=\"login-title\">Login</h1>\r\n        \r\n        <!-- Form Email -->\r\n        <div class=\"form-group\">\r\n          <div class=\"input-container\">\r\n            <img class=\"icon\" src=\"@/assets/user.png\" alt=\"User\" />\r\n            <input type=\"email\" placeholder=\"Email\" class=\"input-field\" />\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Form Password -->\r\n        <div class=\"form-group\">\r\n          <div class=\"input-container\">\r\n            <img class=\"icon\" src=\"@/assets/key.png\" alt=\"Key\" />\r\n            <input type=\"password\" placeholder=\"Password\" class=\"input-field\" />\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Tombol Masuk -->\r\n        <button class=\"login-btn\">Masuk</button>\r\n\r\n        <!-- Link Sign-up -->\r\n        <div class=\"signup-link\">\r\n          <span>belum punya akun? </span>\r\n          <a href=\"#\" class=\"signup-text\">Sign-in</a>\r\n        </div>\r\n\r\n        <!-- Pembatas -->\r\n        <div class=\"divider\">\r\n          <img class=\"vector\" alt=\"Vector\" src=\"@/assets/vector-15.svg\" />\r\n          <span class=\"or-text\">Atau</span>\r\n          <img class=\"vector\" alt=\"Vector\" src=\"@/assets/vector-16.svg\" />\r\n        </div>\r\n\r\n        <!-- Login Sosial -->\r\n        <div class=\"social-login\">\r\n          <img class=\"social-icon\" src=\"@/assets/facebook-circled.png\" alt=\"Facebook\" />\r\n          <img class=\"social-icon\" src=\"@/assets/twitter-circled.jpg\" alt=\"Twitter\" />\r\n          <img class=\"social-icon\" src=\"@/assets/google.png\" alt=\"Google\" />\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"LoginPages\",\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* Reset dasar */\r\n* {\r\n  box-sizing: border-box;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n/* Container utama */\r\n.login-web {\r\n  display: flex;